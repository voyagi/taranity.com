{
  "name": "taranity.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve:test": "node scripts/serve-headers.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "node scripts/prep-e2e.mjs && dev-browser --headless --timeout 180 run scripts/e2e.devbrowser.js",
    "deploy": "astro build && npx wrangler pages deploy dist --project-name taranity",
    "astro": "astro"
  },
  "overrides": {
    "devalue": ">=5.8.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "astro-eslint-parser": "^1.4.0",
    "axe-core": "^4.12.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "lighthouse": "^13.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
