---
/**
 * Fixed control to switch designs and toggle light or dark. Only `ready` designs
 * appear (registry flag), so the design list shows up once a second design ships.
 * Neutral and unobtrusive so it sits over any design. Behaviour is in
 * src/lib/design-theme.ts (delegated, View-Transition safe).
 *
 * Discoverability: the showcase only works if a visitor realises the same site
 * is rebuilt in several designs. Three cues make that obvious without clutter:
 *   1. a "Designs" label that frames the pills as design choices, not nav;
 *   2. the current design's pill is marked active (aria-current, build-time per
 *      route), so the others read as alternatives to try;
 *   3. a permanent floating invite ("Same site, N designs. Take your pick.")
 *      that points at the pills. Its copy is count-driven so it stays correct
 *      as designs are added or removed.
 * The invite/label are static markup (no inline script), so the shared CSP hash
 * is untouched.
 *
 * The light/dark control is a segmented sun/moon toggle (the active mode lit),
 * so it reads as a theme switch with two states rather than a mystery dot.
 * Single-mode designs (Atlas is dark-only) hide it: a control that visibly does
 * nothing reads as broken. The stored preference still applies the moment the
 * visitor switches to a design with both modes.
 */
import { readyDesigns, getDesign } from '../config/designs';

interface Props {
  /** Active design id; decides whether the mode toggle is offered. */
  design: string;
}
const { design } = Astro.props;
const items = readyDesigns();
const multi = items.length > 1;
const hasModes = (getDesign(design)?.modes.length ?? 2) > 1;

// On a subpage (privacy), switching designs should keep the visitor on the
// equivalent subpage rather than dropping them on the target design's home.
// Detected from the URL so no page has to pass a prop. Vitrine's privacy is at
// /privacy; the other designs are at /<id>/privacy.
const onPrivacy = Astro.url.pathname.replace(/\/$/, '').endsWith('/privacy');
const hrefFor = (d: { id: string; route: string }) =>
  onPrivacy ? (d.id === 'vitrine' ? '/privacy' : `/${d.id}/privacy`) : d.route;
---

<div class="design-switcher" data-design-switcher>
  {
    multi && (
      <div class="ds-nudge" data-design-nudge>
        <span class="ds-nudge-arrow" aria-hidden="true">↓</span>
        <span class="ds-nudge-text">{`Same site, ${items.length} designs. Take your pick.`}</span>
      </div>
    )
  }
  {
    hasModes && (
      <button type="button" class="ds-mode" data-mode-toggle aria-label="Switch between light and dark">
        <span class="ds-mode-opt ds-mode-sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2.5M12 19.5V22M22 12h-2.5M4.5 12H2M19.07 4.93l-1.77 1.77M6.7 17.3l-1.77 1.77M19.07 19.07l-1.77-1.77M6.7 6.7 4.93 4.93" />
          </svg>
        </span>
        <span class="ds-mode-opt ds-mode-moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
          </svg>
        </span>
      </button>
    )
  }
  {multi && <span class="ds-label" aria-hidden="true">Designs</span>}
  {
    multi && (
      <nav class="ds-designs" aria-label="Choose a design">
        {items.map((d) => (
          <a
            class="ds-design"
            href={hrefFor(d)}
            data-design-go={d.id}
            aria-current={d.id === design ? 'page' : undefined}
            title={`${d.tagline} for ${d.audience}`}
          >
            {d.name}
          </a>
        ))}
      </nav>
    )
  }
</div>

<style>
  .design-switcher {
    position: fixed;
    z-index: 1000;
    bottom: max(1rem, env(safe-area-inset-bottom));
    right: 1rem;
    display: inline-flex;
    align-items: center;
    /* With five ready designs the pill row is wider than a small phone. Cap it
       to the viewport and let it wrap (growing upward from the bottom-right)
       so no design link is ever pushed off-screen and clipped. */
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: calc(100vw - 2rem);
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, Canvas 72%, transparent);
    border: 1px solid color-mix(in srgb, CanvasText 18%, transparent);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    font-family: ui-sans-serif, system-ui, sans-serif;
    color: CanvasText;
  }
  /* A segmented sun/moon toggle: showing both icons with the active one lit makes
     it obvious this is a light/dark switch with two states, not a mystery dot.
     Only rendered on dual-mode designs. Mode-reactive via :global() so the
     :root[data-mode] ancestor stays out of Astro's component scoping. */
  .ds-mode {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.15rem;
    border: 1px solid color-mix(in srgb, CanvasText 16%, transparent);
    border-radius: 999px;
    cursor: pointer;
    background: transparent;
    color: inherit;
  }
  .ds-mode-opt {
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    /* inactive mode is dimmed; the active mode is lit + sits in a filled pill */
    opacity: 0.4;
  }
  .ds-mode-opt svg {
    width: 0.9rem;
    height: 0.9rem;
  }
  .ds-mode-sun {
    opacity: 1;
    background: color-mix(in srgb, CanvasText 16%, transparent);
  }
  :global(:root[data-mode='dark']) .ds-mode-sun {
    opacity: 0.4;
    background: transparent;
  }
  :global(:root[data-mode='dark']) .ds-mode-moon {
    opacity: 1;
    background: color-mix(in srgb, CanvasText 16%, transparent);
  }
  /* No-JS fallback: follow the system when no explicit mode has been chosen. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-mode])) .ds-mode-sun {
      opacity: 0.4;
      background: transparent;
    }
    :global(:root:not([data-mode])) .ds-mode-moon {
      opacity: 1;
      background: color-mix(in srgb, CanvasText 16%, transparent);
    }
  }
  .ds-designs {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    /* allow the nav to shrink below its content width so its pills can wrap
       (without this, min-width:auto keeps the row from ever breaking) */
    min-width: 0;
    gap: 0.15rem;
  }
  /* A non-interactive section title, set off from the design pills by a hairline
     divider and a quieter micro-caps treatment, so it never reads as another
     selectable item. */
  .ds-label {
    align-self: stretch;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.35rem 0.6rem;
    margin-right: 0.15rem;
    border-right: 1px solid color-mix(in srgb, CanvasText 20%, transparent);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* 0.7, not lower: at 0.5 the composite over the light switcher pill drops
       under 4.5:1 (axe). Still clearly subordinate via the divider + micro-caps. */
    opacity: 0.7;
    white-space: nowrap;
  }
  .ds-design {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
    white-space: nowrap;
  }
  .ds-design:hover {
    opacity: 1;
    background: color-mix(in srgb, CanvasText 10%, transparent);
  }
  /* "You are here": the current design is filled and solid, so the rest read as
     alternatives to try. Set at build time per route (aria-current). */
  .ds-design[aria-current='page'] {
    opacity: 1;
    font-weight: 600;
    background: color-mix(in srgb, CanvasText 16%, transparent);
  }

  /* Permanent floating invite. Floats just above the pill (out of flow, so it
     never changes how the pill wraps) and is near-opaque for readable text over
     any design. */
  .ds-nudge {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.5rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: min(20rem, calc(100vw - 2rem));
    padding: 0.5rem 0.7rem;
    border-radius: 0.85rem;
    background: color-mix(in srgb, Canvas 94%, transparent);
    border: 1px solid color-mix(in srgb, CanvasText 22%, transparent);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    box-shadow: 0 8px 24px color-mix(in srgb, CanvasText 20%, transparent);
    font-size: 0.8rem;
    line-height: 1.3;
  }
  .ds-nudge-arrow {
    font-size: 1rem;
    opacity: 0.65;
  }
  .ds-nudge-text {
    flex: 1 1 auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ds-design { transition: opacity 0.2s, background-color 0.2s; }
    .ds-mode-opt { transition: opacity 0.2s, background-color 0.2s; }
  }

  /* Slim it on small screens: tighter pills, a smaller toggle, drop the label
     (the invite already frames the row) and compact the invite, so the wrapped
     switcher takes far less vertical space at the foot of the page. */
  @media (max-width: 640px) {
    .design-switcher {
      gap: 0.28rem;
      padding: 0.3rem;
    }
    .ds-label {
      display: none;
    }
    .ds-design {
      padding: 0.26rem 0.5rem;
      font-size: 0.66rem;
      letter-spacing: 0;
    }
    .ds-mode {
      padding: 0.12rem;
    }
    .ds-mode-opt {
      width: 1.2rem;
      height: 1.2rem;
    }
    .ds-mode-opt svg {
      width: 0.78rem;
      height: 0.78rem;
    }
    .ds-nudge {
      max-width: min(16rem, calc(100vw - 2rem));
      padding: 0.4rem 0.55rem;
      font-size: 0.72rem;
    }
  }
</style>
