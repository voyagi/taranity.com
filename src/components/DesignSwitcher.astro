---
/**
 * Fixed control to switch designs and toggle light or dark. Only `ready` designs
 * appear (registry flag), so the design list shows up once a second design ships.
 * Neutral and unobtrusive so it sits over any design. Behaviour is in
 * src/lib/design-theme.ts (delegated, View-Transition safe).
 *
 * Discoverability: the showcase only works if a visitor realises the same site
 * is rebuilt in several designs. Three cues make that obvious without clutter:
 *   1. a "Designs" label that frames the pills as design choices, not nav;
 *   2. the current design's pill is marked active (aria-current, build-time per
 *      route), so the others read as alternatives to try;
 *   3. a permanent floating invite ("Same site, N designs. Take your pick.")
 *      that points at the pills. Its copy is count-driven so it stays correct
 *      as designs are added or removed.
 * The invite/label are static markup (no inline script), so the shared CSP hash
 * is untouched.
 *
 * Single-mode designs (Atlas is dark-only) hide the mode toggle: a control
 * that visibly does nothing reads as broken. The stored preference still
 * applies the moment the visitor switches to a design with both modes.
 */
import { readyDesigns, getDesign } from '../config/designs';

interface Props {
  /** Active design id; decides whether the mode toggle is offered. */
  design: string;
}
const { design } = Astro.props;
const items = readyDesigns();
const multi = items.length > 1;
const hasModes = (getDesign(design)?.modes.length ?? 2) > 1;
---

<div class="design-switcher" data-design-switcher>
  {
    multi && (
      <div class="ds-nudge" data-design-nudge>
        <span class="ds-nudge-arrow" aria-hidden="true">↓</span>
        <span class="ds-nudge-text">{`Same site, ${items.length} designs. Take your pick.`}</span>
      </div>
    )
  }
  {
    hasModes && (
      <button type="button" class="ds-mode" data-mode-toggle aria-label="Toggle light or dark">
        <span class="ds-mode-dot" aria-hidden="true" />
      </button>
    )
  }
  {multi && <span class="ds-label" aria-hidden="true">Designs</span>}
  {
    multi && (
      <nav class="ds-designs" aria-label="Choose a design">
        {items.map((d) => (
          <a
            class="ds-design"
            href={d.route}
            data-design-go={d.id}
            aria-current={d.id === design ? 'page' : undefined}
            title={`${d.tagline} for ${d.audience}`}
          >
            {d.name}
          </a>
        ))}
      </nav>
    )
  }
</div>

<style>
  .design-switcher {
    position: fixed;
    z-index: 1000;
    bottom: max(1rem, env(safe-area-inset-bottom));
    right: 1rem;
    display: inline-flex;
    align-items: center;
    /* With five ready designs the pill row is wider than a small phone. Cap it
       to the viewport and let it wrap (growing upward from the bottom-right)
       so no design link is ever pushed off-screen and clipped. */
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: calc(100vw - 2rem);
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, Canvas 72%, transparent);
    border: 1px solid color-mix(in srgb, CanvasText 18%, transparent);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    font-family: ui-sans-serif, system-ui, sans-serif;
    color: CanvasText;
  }
  .ds-mode {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 0;
    cursor: pointer;
    background: transparent;
    color: inherit;
  }
  .ds-mode-dot {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 2px solid currentColor;
    /* a half-filled disc reads as a light/dark toggle in any theme */
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }
  .ds-designs {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    /* allow the nav to shrink below its content width so its pills can wrap
       (without this, min-width:auto keeps the row from ever breaking) */
    min-width: 0;
    gap: 0.15rem;
  }
  /* A non-interactive label so the pills read as design choices, not page nav. */
  .ds-label {
    align-self: center;
    padding-left: 0.3rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
    white-space: nowrap;
  }
  .ds-design {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
    white-space: nowrap;
  }
  .ds-design:hover {
    opacity: 1;
    background: color-mix(in srgb, CanvasText 10%, transparent);
  }
  /* "You are here": the current design is filled and solid, so the rest read as
     alternatives to try. Set at build time per route (aria-current). */
  .ds-design[aria-current='page'] {
    opacity: 1;
    font-weight: 600;
    background: color-mix(in srgb, CanvasText 16%, transparent);
  }

  /* Permanent floating invite. Floats just above the pill (out of flow, so it
     never changes how the pill wraps) and is near-opaque for readable text over
     any design. */
  .ds-nudge {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.5rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: min(20rem, calc(100vw - 2rem));
    padding: 0.5rem 0.7rem;
    border-radius: 0.85rem;
    background: color-mix(in srgb, Canvas 94%, transparent);
    border: 1px solid color-mix(in srgb, CanvasText 22%, transparent);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    box-shadow: 0 8px 24px color-mix(in srgb, CanvasText 20%, transparent);
    font-size: 0.8rem;
    line-height: 1.3;
  }
  .ds-nudge-arrow {
    font-size: 1rem;
    opacity: 0.65;
  }
  .ds-nudge-text {
    flex: 1 1 auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ds-design { transition: opacity 0.2s, background-color 0.2s; }
  }
</style>
