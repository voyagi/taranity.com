---
/**
 * Page footer. Kept deliberately small: legal line, design note, privacy.
 */
const year = new Date().getFullYear();
---

<footer class="f-footer">
  <p>© {year} Taranity</p>
  <p class="f-footer-note" aria-hidden="true">Storefront · a Taranity design language</p>
  <a href="/privacy">Privacy</a>
</footer>

<style>
  .f-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-inline: var(--f-pad);
    margin-top: clamp(3rem, 8vh, 5rem);
    padding-block: 1.8rem 2.4rem;
    border-top: 2px solid var(--f-line);
    font-size: 0.8rem;
    color: var(--f-muted);
  }
  .f-footer-note {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .f-footer a {
    color: inherit;
    text-underline-offset: 4px;
  }
  .f-footer a:hover {
    color: var(--f-ink);
  }
</style>
