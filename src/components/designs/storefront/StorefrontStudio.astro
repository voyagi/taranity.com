---
/**
 * Who is behind the work. Small crew, worldwide range, written-first. The
 * principles read like a product team's working agreement, presented as tactile
 * swatch chips rather than an about page.
 */
const principles = [
  'Written over meetings',
  'Ship in increments',
  'Measure, then decide',
  'We stay after launch',
];
---

<section class="f-section f-studio" id="studio" tabindex="-1">
  <p class="f-label" data-f-fade>04 · Studio</p>

  <h2 class="f-statement f-display" data-f-lines>
    <span class="f-mask"><span class="f-mask-inner">A small crew</span></span>
    <span class="f-mask"><span class="f-mask-inner">that ships.</span></span>
  </h2>

  <div class="f-studio-grid">
    <div class="f-studio-copy" data-f-fade>
      <p>
        Taranity works with founders, retailers, and teams of every size, across
        every timezone, in writing. Small on purpose: the people who scope your
        work are the people who build it.
      </p>
      <p>
        One thing at a time, taken end to end. We would rather ship one brand
        that buyers come back to than five that merely exist.
      </p>
    </div>
    <ul class="f-principles" data-f-fade>
      {
        principles.map((p, i) => (
          <li>
            <span class="f-principle-chip" style={`background: var(--f-c${i + 1})`} aria-hidden="true" />
            {p}
          </li>
        ))
      }
    </ul>
  </div>

  <span class="f-rule" data-f-rule aria-hidden="true"></span>
</section>

<style>
  .f-studio-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    margin-bottom: clamp(2.6rem, 7vh, 4rem);
  }
  .f-studio-copy p {
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.3vw, 1.14rem);
    line-height: 1.68;
    color: var(--f-muted);
  }
  .f-studio-copy p + p {
    margin-top: 1.2rem;
  }
  .f-principles {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .f-principles li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-block: 0.95rem;
    border-top: 1px solid var(--f-line);
    font-family: var(--f-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--f-ink);
  }
  .f-principles li:last-child {
    border-bottom: 1px solid var(--f-line);
  }
  .f-principle-chip {
    width: 14px;
    height: 14px;
    border-radius: 5px;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.6);
    flex-shrink: 0;
  }
  @media (max-width: 820px) {
    .f-studio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
