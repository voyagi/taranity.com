---
/**
 * Storefront subpage shell (privacy): the Storefront palette and type on a
 * minimal, legible legal page (no promo marquee). The root `.storefront` class
 * supplies background, colour, and font; the inline mappings expose its tokens
 * to the shared --sp-* bridge variables consumed by subpage.css.
 */
import './storefront.css';
import '../../../styles/subpage.css';
import StorefrontFooter from './StorefrontFooter.astro';
---

<div
  class="storefront sp-shell"
  style="--sp-accent: var(--f-accent); --sp-line: var(--f-line); --sp-muted: var(--f-muted); --sp-display: var(--f-display); --sp-pad: clamp(1.25rem, 5vw, 4rem);"
>
  <header class="sp-masthead">
    <a class="sp-word" href="/storefront">Taranity</a>
    <a class="sp-home" href="/storefront">Back to Storefront</a>
  </header>
  <main class="sp-main">
    <div class="subpage-body"><slot /></div>
  </main>
  <StorefrontFooter />
</div>
