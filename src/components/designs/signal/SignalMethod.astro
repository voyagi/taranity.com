---
/**
 * How an engagement runs: four steps from first conversation to long after
 * launch. A linear, legible process; the promises stay concrete. Conversion
 * reassurance: the visitor can see exactly what working with us looks like.
 */
const steps = [
  {
    index: '01',
    name: 'Define',
    copy: 'We pin the outcome and the metric that proves it, then agree scope in writing. No drawing until the goal is clear.',
  },
  {
    index: '02',
    name: 'Design',
    copy: 'Flows and screens that guide every visitor to the next step. You review real direction, not slideware.',
  },
  {
    index: '03',
    name: 'Build',
    copy: 'Design and engineering in one motion, shipped in working increments you can click through as they land.',
  },
  {
    index: '04',
    name: 'Improve',
    copy: 'Launch starts the loop. We measure what real users do and tune for the number that matters, and we stay for it.',
  },
];
---

<section class="s-section s-method" id="method" tabindex="-1">
  <p class="s-label" data-s-fade>03 · Method</p>

  <h2 class="s-statement s-display" data-s-lines>
    <span class="s-mask"><span class="s-mask-inner">A process you</span></span>
    <span class="s-mask"><span class="s-mask-inner">can plan around.</span></span>
  </h2>

  <ol class="s-steps">
    {
      steps.map((step) => (
        <li class="s-step" data-s-fade>
          <span class="s-step-index">{step.index}</span>
          <h3 class="s-step-name s-display">{step.name}</h3>
          <p class="s-step-copy">{step.copy}</p>
        </li>
      ))
    }
  </ol>

  <span class="s-rule" data-s-rule aria-hidden="true"></span>
</section>

<style>
  .s-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.4rem, 3vw, 2.4rem);
    margin: 0 0 clamp(2.6rem, 7vh, 4rem);
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .s-step {
    padding-top: 1.4rem;
    border-top: 2px solid var(--s-line);
    position: relative;
  }
  .s-step::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: clamp(1.6rem, 3vw, 2.4rem);
    height: 2px;
    background: var(--s-accent);
  }
  .s-step-index {
    font-family: var(--s-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    color: var(--s-accent);
  }
  .s-step-name {
    display: block;
    margin-top: 0.6rem;
    font-size: clamp(1.25rem, 2vw, 1.7rem);
  }
  .s-step-copy {
    margin-top: 0.7rem;
    font-size: 0.95rem;
    line-height: 1.62;
    color: var(--s-muted);
  }
  @media (max-width: 900px) {
    .s-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .s-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
