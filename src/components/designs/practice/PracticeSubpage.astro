---
/**
 * Practice subpage shell (privacy): the Practice palette and serif type on a
 * minimal, legible legal page (no trust strip). The root `.practice` class
 * supplies background, colour, and font; the inline mappings expose its tokens
 * to the shared --sp-* bridge variables consumed by subpage.css.
 */
import './practice.css';
import '../../../styles/subpage.css';
import PracticeFooter from './PracticeFooter.astro';
---

<div
  class="practice sp-shell"
  style="--sp-accent: var(--p-accent); --sp-line: var(--p-line); --sp-muted: var(--p-muted); --sp-display: var(--p-display); --sp-pad: clamp(1.25rem, 5vw, 4rem);"
>
  <header class="sp-masthead">
    <a class="sp-word" href="/practice">Taranity</a>
    <a class="sp-home" href="/practice">Back to Practice</a>
  </header>
  <main class="sp-main">
    <div class="subpage-body"><slot /></div>
  </main>
  <PracticeFooter />
</div>
