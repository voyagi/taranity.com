---
/**
 * Written contact only (hard rule 1: no booking, no calls): a short form and a
 * direct email address, framed as the page's primary conversion. Submission
 * posts to Web3Forms with the same hardened pattern as the other designs
 * (hardcoded endpoint, honeypot, demo mode without a key, inline validation),
 * restyled brutalist for Raw.
 */
import { services, socials, contactEmail } from '../../../config/site';

const hasKey = Boolean(services.web3formsKey);
const hasTurnstile = Boolean(services.turnstileSitekey);
---

<section class="r-section r-contact" id="contact" tabindex="-1">
  <div class="r-contact-grid">
    <div class="r-contact-aside" data-r-fade>
      <p class="r-label">05 / Contact</p>
      <h2 class="r-statement r-display r-glitch" data-r-lines>
        <span class="r-mask"><span class="r-mask-inner">Tell us what</span></span>
        <span class="r-mask"><span class="r-mask-inner">you're making.</span></span>
      </h2>
      <p class="r-contact-lead">
        Send what you do and what you are chasing. We read everything and reply
        within a day, in writing, with a clear next step. No calls, no funnel.
      </p>
      <a class="r-contact-email r-display" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <p class="r-contact-loc">Working with clients worldwide</p>
      <ul class="r-contact-socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="r-form-wrap r-card-surface" data-r-fade>
      <form
        class="r-form"
        data-r-form
        data-fallback-email={contactEmail}
        action="https://api.web3forms.com/submit"
        method="POST"
        novalidate
      >
        <input type="hidden" name="access_key" value={services.web3formsKey} />
        <input type="hidden" name="subject" value="New enquiry via taranity.com (Raw)" />
        <input type="hidden" name="from_name" value="taranity.com" />
        <!-- Honeypot -->
        <input type="checkbox" name="botcheck" class="r-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        {
          !hasKey && (
            <p class="r-demo-note">Demo mode: add a Web3Forms key to send for real (see HUMAN-TODO).</p>
          )
        }

        <div class="r-field-row">
          <label for="r-name">Name</label>
          <input id="r-name" name="name" type="text" required maxlength="100" autocomplete="name" aria-describedby="r-err-name" />
          <span class="r-field-err" id="r-err-name" data-r-err="name" role="alert"></span>
        </div>

        <div class="r-field-row">
          <label for="r-email">Email</label>
          <input id="r-email" name="email" type="email" required maxlength="150" autocomplete="email" aria-describedby="r-err-email" />
          <span class="r-field-err" id="r-err-email" data-r-err="email" role="alert"></span>
        </div>

        <div class="r-field-row">
          <label for="r-message">What are you making?</label>
          <textarea id="r-message" name="message" rows="5" required maxlength="3000" aria-describedby="r-err-message"></textarea>
          <span class="r-field-err" id="r-err-message" data-r-err="message" role="alert"></span>
        </div>

        {hasTurnstile && (
          <Fragment>
            <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
            <div class="cf-turnstile" data-sitekey={services.turnstileSitekey} data-action="turnstile-spin-v1" data-theme="auto" style="margin-bottom: 1.5rem"></div>
          </Fragment>
        )}

        <button type="submit" class="r-cta r-cta-primary r-submit">
          <span data-r-submit-label>Send it</span>
          <span class="r-cta-arrow" aria-hidden="true">&rarr;</span>
        </button>

        <p class="r-form-status" data-r-form-status role="status" aria-live="polite"></p>
        <p class="r-form-privacy">
          Delivered via Web3Forms and used only to reply. No cookies, nothing
          sold. <a href="/privacy" data-astro-reload>How your data is handled</a>.
        </p>
      </form>

      <div class="r-form-success" data-r-form-success hidden tabindex="-1">
        <h3 class="r-display">Got it.</h3>
        <p>Your message is in. We reply within a day, usually sooner, and always in writing.</p>
      </div>
    </div>
  </div>

  <span class="r-rule" data-r-rule aria-hidden="true"></span>
</section>

<style>
  .r-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2.4rem, 6vw, 5rem);
    align-items: start;
    margin-bottom: clamp(3rem, 8vh, 4.5rem);
  }
  .r-contact-aside .r-statement {
    margin-block: clamp(0.9rem, 2.4vh, 1.4rem) clamp(1.4rem, 3.5vh, 2rem);
  }
  .r-contact-lead {
    max-width: 42ch;
    margin-bottom: clamp(1.6rem, 4vh, 2.2rem);
    font-size: 0.98rem;
    line-height: 1.68;
    color: var(--r-muted);
  }
  .r-contact-email {
    display: inline-block;
    font-size: clamp(1.1rem, 2.2vw, 1.7rem);
    text-transform: none;
    color: var(--r-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--r-cy);
    padding-bottom: 2px;
  }
  .r-contact-email:hover {
    background: var(--r-cy);
    color: #07181a;
  }
  .r-contact-loc {
    margin-top: 0.9rem;
    font-family: var(--r-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--r-muted);
  }
  .r-contact-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .r-contact-socials a {
    font-family: var(--r-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--r-muted);
  }
  .r-contact-socials a:hover {
    color: var(--r-ink);
  }

  /* Form card: hard-bordered fields on a solid surface, capped to a humane
     measure. No rounding anywhere. */
  .r-form-wrap {
    --r-card-accent: var(--r-mg);
    padding: clamp(1.5rem, 3vw, 2.4rem);
  }
  .r-hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }
  .r-demo-note {
    margin-bottom: 1.5rem;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--r-line-strong);
    background: color-mix(in srgb, var(--r-cy) 12%, transparent);
    font-family: var(--r-mono);
    font-size: 0.76rem;
    color: var(--r-ink);
  }
  .r-field-row {
    margin-bottom: 1.4rem;
  }
  .r-field-row label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--r-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--r-muted);
  }
  .r-field-row input,
  .r-field-row textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    background: var(--r-bg);
    border: 1.5px solid var(--r-line-strong);
    border-radius: 0;
    font-family: var(--r-mono);
    font-size: 0.95rem;
    color: var(--r-ink);
  }
  .r-field-row textarea {
    resize: vertical;
    min-height: 120px;
  }
  .r-field-row input::placeholder,
  .r-field-row textarea::placeholder {
    color: color-mix(in srgb, var(--r-muted) 70%, transparent);
  }
  .r-field-row input:focus-visible,
  .r-field-row textarea:focus-visible {
    outline: none;
    border-color: var(--r-cy);
    box-shadow: 3px 3px 0 0 var(--r-cy);
  }
  .r-field-row.invalid input,
  .r-field-row.invalid textarea {
    border-color: var(--r-error);
  }
  .r-field-err {
    display: block;
    min-height: 1rem;
    margin-top: 0.4rem;
    font-family: var(--r-mono);
    font-size: 0.74rem;
    color: var(--r-error);
  }

  .r-submit {
    margin-top: 0.4rem;
    width: 100%;
    justify-content: center;
  }
  .r-submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .r-form-status {
    min-height: 1rem;
    margin-top: 1rem;
    font-family: var(--r-mono);
    font-size: 0.82rem;
    color: var(--r-muted);
  }
  .r-form-status.is-error {
    color: var(--r-error);
  }
  .r-form-privacy {
    margin-top: 1.2rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--r-muted);
  }
  .r-form-privacy a {
    color: var(--r-ink);
    text-underline-offset: 3px;
  }

  .r-form-success:focus {
    outline: none;
  }
  .r-form-success h3 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 0.7rem;
  }
  .r-form-success p {
    max-width: 40ch;
    color: var(--r-muted);
    line-height: 1.7;
  }
  .r-form-success[hidden] {
    display: none;
  }

  @media (max-width: 820px) {
    .r-contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  /**
   * Same hardened submit flow as the other designs' forms: client validation,
   * honeypot, demo mode without a key, and a hardcoded endpoint (never trust a
   * DOM attribute for the POST target).
   */
  function bindRawForm() {
    const form = document.querySelector<HTMLFormElement>('[data-r-form]');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';

    // Read the key from the rendered hidden field (not import.meta.env) so this
    // script's bytes, and thus its CSP hash, never change when a key is set.
    const KEY = (form.querySelector<HTMLInputElement>('input[name="access_key"]')?.value || '').trim();

    const status = form.querySelector<HTMLElement>('[data-r-form-status]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('.r-submit')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-r-submit-label]')!;
    // The success panel is the form's sibling inside .r-form-wrap; scope the
    // lookup there so a second instance of this component could never grab
    // another form's panel.
    const successPanel = form.closest('.r-form-wrap')!.querySelector<HTMLElement>('[data-r-form-success]')!;

    // Cloudflare Turnstile: render the widget explicitly so it survives Astro
    // view-transition navigation (api.js does not auto-rescan on client nav).
    // No widget when no sitekey is configured (demo builds) → the gate is skipped.
    const tsEl = form.querySelector<HTMLElement>('.cf-turnstile');
    if (tsEl) {
      const renderTurnstile = () => {
        if (!window.turnstile || tsEl.dataset.tsRendered) return false;
        window.turnstile.render(tsEl);
        tsEl.dataset.tsRendered = '1';
        return true;
      };
      if (!renderTurnstile()) {
        const iv = window.setInterval(() => {
          if (renderTurnstile()) window.clearInterval(iv);
        }, 150);
        window.setTimeout(() => window.clearInterval(iv), 10000);
      }
    }

    const setErr = (name: string, msg: string) => {
      const field = form.querySelector(`[name="${name}"]`)?.closest('.r-field-row');
      const errEl = form.querySelector(`[data-r-err="${name}"]`);
      if (field) field.classList.toggle('invalid', Boolean(msg));
      if (errEl) errEl.textContent = msg;
    };

    const validate = () => {
      let ok = true;
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const message = String(data.get('message') || '').trim();

      setErr('name', name ? '' : 'Tell us your name.');
      if (!name) ok = false;

      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      setErr('email', email ? (emailOk ? '' : 'That email looks off.') : 'We need an email to reply.');
      if (!emailOk) ok = false;

      setErr('message', message.length >= 10 ? '' : 'A sentence or two, please (10+ characters).');
      if (message.length < 10) ok = false;

      if (!ok) {
        form.querySelector<HTMLElement>('.r-field-row.invalid input, .r-field-row.invalid textarea')?.focus();
      }
      return ok;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.classList.remove('is-error');
      if (!validate()) return;

      if ((form.querySelector('[name="botcheck"]') as HTMLInputElement)?.checked) return;

      // Turnstile gate: a human-verified token must clear server-side (/api/verify)
      // before the real submit runs. Only active when a widget rendered (sitekey set).
      if (tsEl) {
        const tsToken = (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value || '';
        const tsFail = (msg: string) => {
          status.textContent = msg;
          status.classList.add('is-error');
          window.turnstile?.reset(tsEl);
        };
        if (!tsToken) {
          const fallback = form.dataset.fallbackEmail || 'hello@taranity.com';
          tsFail(`Please complete the verification above, or email us directly at ${fallback}.`);
          return;
        }
        try {
          const vr = await fetch('/api/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: tsToken }),
          });
          const vj = (await vr.json().catch(() => ({}))) as { success?: boolean };
          if (!vj.success) {
            tsFail('Verification failed. Please try again.');
            return;
          }
        } catch {
          tsFail('Could not verify you are human. Email us directly if this keeps happening.');
          return;
        }
      }

      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending…';

      const showSuccess = () => {
        form.hidden = true;
        successPanel.hidden = false;
        // A smooth scroll fights a reduced-motion preference; jump instantly then.
        successPanel.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'center',
        });
        // Keyboard/SR users were focused on the now-hidden submit button:
        // move focus so the confirmation is announced and reachable.
        successPanel.focus({ preventScroll: true });
      };

      // Demo mode: no key, simulate success so the flow stays reviewable.
      if (!KEY) {
        await new Promise((r) => setTimeout(r, 700));
        showSuccess();
        return;
      }

      // Abort a stalled request: without this a hung endpoint leaves the form
      // stuck on the sending label with no way to retry.
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 12000);
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
          signal: controller.signal,
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          showSuccess();
        } else {
          throw new Error(json.message || 'Send failed');
        }
      } catch {
        const fallbackEmail = form.dataset.fallbackEmail || 'hello@taranity.com';
        status.textContent = `Could not send. Email ${fallbackEmail} directly?`;
        status.classList.add('is-error');
        submitBtn.disabled = false;
        submitLabel.textContent = 'Try again';
      } finally {
        clearTimeout(timeout);
      }
    });

    // Clear an error as soon as the visitor edits the field.
    form.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('input', () => {
        const name = (el as HTMLInputElement).name;
        if (el.closest('.r-field-row')?.classList.contains('invalid')) setErr(name, '');
      });
    });
  }

  document.addEventListener('astro:page-load', bindRawForm);
</script>
