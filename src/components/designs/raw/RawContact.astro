---
/**
 * Written contact only (hard rule 1: no booking, no calls): a short form and a
 * direct email address, framed as the page's primary conversion. Submission
 * uses the same-origin contact API, which verifies Turnstile server-side before
 * forwarding to Web3Forms; the client keeps a hardcoded endpoint, honeypot, and
 * inline validation, restyled brutalist for Raw.
 */
import { services, socials, contactEmail } from '../../../config/site';

const hasTurnstile = Boolean(services.turnstileSitekey);
---

<section class="r-section r-contact" id="contact" tabindex="-1">
  <div class="r-contact-grid">
    <div class="r-contact-aside" data-r-fade>
      <p class="r-label">05 / Contact</p>
      <h2 class="r-statement r-display r-glitch" data-r-lines>
        <span class="r-mask"><span class="r-mask-inner">Tell us what</span></span>
        <span class="r-mask"><span class="r-mask-inner">you're making.</span></span>
      </h2>
      <p class="r-contact-lead">
        Send what you do and what you are chasing. We read everything and reply
        within a day, in writing, with a clear next step. No calls, no funnel.
      </p>
      <a class="r-contact-email r-display" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <p class="r-contact-loc">Working with clients worldwide</p>
      <ul class="r-contact-socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="r-form-wrap r-card-surface" data-r-fade>
      <form
        class="r-form"
        data-r-form
        data-fallback-email={contactEmail}
        action="/api/contact"
        method="POST"
        novalidate
      >
        <input type="hidden" name="subject" value="New enquiry via taranity.com (Raw)" />
        <input type="hidden" name="from_name" value="taranity.com" />
        <!-- Honeypot -->
        <input type="checkbox" name="botcheck" class="r-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        {
          !hasTurnstile && (
            <p class="r-demo-note">Demo mode: submissions are simulated in this preview.</p>
          )
        }

        <div class="r-field-row">
          <label for="r-name">Name</label>
          <input id="r-name" name="name" type="text" required maxlength="100" autocomplete="name" aria-describedby="r-err-name" />
          <span class="r-field-err" id="r-err-name" data-r-err="name" role="alert"></span>
        </div>

        <div class="r-field-row">
          <label for="r-email">Email</label>
          <input id="r-email" name="email" type="email" required maxlength="150" autocomplete="email" aria-describedby="r-err-email" />
          <span class="r-field-err" id="r-err-email" data-r-err="email" role="alert"></span>
        </div>

        <div class="r-field-row">
          <label for="r-message">What are you making?</label>
          <textarea id="r-message" name="message" rows="5" required maxlength="3000" aria-describedby="r-err-message"></textarea>
          <span class="r-field-err" id="r-err-message" data-r-err="message" role="alert"></span>
        </div>

        {hasTurnstile && (
          <Fragment>
            <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
            <div class="cf-turnstile" data-sitekey={services.turnstileSitekey} data-action="turnstile-spin-v1" data-theme="auto" style="margin-bottom: 1.5rem"></div>
          </Fragment>
        )}

        <button type="submit" class="r-cta r-cta-primary r-submit">
          <span data-r-submit-label>Send it</span>
          <span class="r-cta-arrow" aria-hidden="true">&rarr;</span>
        </button>

        <p class="r-form-status" data-r-form-status role="status" aria-live="polite"></p>
        <p class="r-form-privacy">
          Delivered via Web3Forms and used only to reply. No cookies, nothing
          sold. <a href="/privacy" data-astro-reload>How your data is handled</a>.
        </p>
      </form>

      <div class="r-form-success" data-r-form-success hidden tabindex="-1">
        <h3 class="r-display">Got it.</h3>
        <p>Your message is in. We reply within a day, usually sooner, and always in writing.</p>
      </div>
    </div>
  </div>

  <span class="r-rule" data-r-rule aria-hidden="true"></span>
</section>

<style>
  .r-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2.4rem, 6vw, 5rem);
    align-items: start;
    margin-bottom: clamp(3rem, 8vh, 4.5rem);
  }
  .r-contact-aside .r-statement {
    margin-block: clamp(0.9rem, 2.4vh, 1.4rem) clamp(1.4rem, 3.5vh, 2rem);
  }
  .r-contact-lead {
    max-width: 42ch;
    margin-bottom: clamp(1.6rem, 4vh, 2.2rem);
    font-size: 0.98rem;
    line-height: 1.68;
    color: var(--r-muted);
  }
  .r-contact-email {
    display: inline-block;
    font-size: clamp(1.1rem, 2.2vw, 1.7rem);
    text-transform: none;
    color: var(--r-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--r-cy);
    padding-bottom: 2px;
  }
  .r-contact-email:hover {
    background: var(--r-cy);
    color: #07181a;
  }
  .r-contact-loc {
    margin-top: 0.9rem;
    font-family: var(--r-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--r-muted);
  }
  .r-contact-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .r-contact-socials a {
    font-family: var(--r-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--r-muted);
  }
  .r-contact-socials a:hover {
    color: var(--r-ink);
  }

  /* Form card: hard-bordered fields on a solid surface, capped to a humane
     measure. No rounding anywhere. */
  .r-form-wrap {
    --r-card-accent: var(--r-mg);
    padding: clamp(1.5rem, 3vw, 2.4rem);
  }
  .r-hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }
  .r-demo-note {
    margin-bottom: 1.5rem;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--r-line-strong);
    background: color-mix(in srgb, var(--r-cy) 12%, transparent);
    font-family: var(--r-mono);
    font-size: 0.76rem;
    color: var(--r-ink);
  }
  .r-field-row {
    margin-bottom: 1.4rem;
  }
  .r-field-row label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--r-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--r-muted);
  }
  .r-field-row input,
  .r-field-row textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    background: var(--r-bg);
    border: 1.5px solid var(--r-line-strong);
    border-radius: 0;
    font-family: var(--r-mono);
    font-size: 0.95rem;
    color: var(--r-ink);
  }
  .r-field-row textarea {
    resize: vertical;
    min-height: 120px;
  }
  .r-field-row input::placeholder,
  .r-field-row textarea::placeholder {
    color: color-mix(in srgb, var(--r-muted) 70%, transparent);
  }
  .r-field-row input:focus-visible,
  .r-field-row textarea:focus-visible {
    outline: none;
    border-color: var(--r-cy);
    box-shadow: 3px 3px 0 0 var(--r-cy);
  }
  .r-field-row.invalid input,
  .r-field-row.invalid textarea {
    border-color: var(--r-error);
  }
  .r-field-err {
    display: block;
    min-height: 1rem;
    margin-top: 0.4rem;
    font-family: var(--r-mono);
    font-size: 0.74rem;
    color: var(--r-error);
  }

  .r-submit {
    margin-top: 0.4rem;
    width: 100%;
    justify-content: center;
  }
  .r-submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .r-form-status {
    min-height: 1rem;
    margin-top: 1rem;
    font-family: var(--r-mono);
    font-size: 0.82rem;
    color: var(--r-muted);
  }
  .r-form-status.is-error {
    color: var(--r-error);
  }
  .r-form-privacy {
    margin-top: 1.2rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--r-muted);
  }
  .r-form-privacy a {
    color: var(--r-ink);
    text-underline-offset: 3px;
  }

  .r-form-success:focus {
    outline: none;
  }
  .r-form-success h3 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 0.7rem;
  }
  .r-form-success p {
    max-width: 40ch;
    color: var(--r-muted);
    line-height: 1.7;
  }
  .r-form-success[hidden] {
    display: none;
  }

  @media (max-width: 820px) {
    .r-contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { bindContactForm } from '../../../lib/contact-form';

  document.addEventListener('astro:page-load', () =>
    bindContactForm({
      formSelector: '[data-r-form]',
      statusSelector: '[data-r-form-status]',
      submitButtonSelector: '.r-submit',
      submitLabelSelector: '[data-r-submit-label]',
      successSelector: '[data-r-form-success]',
      wrapperSelector: '.r-form-wrap',
      fieldRowSelector: '.r-field-row',
      errorAttr: 'data-r-err',
      sendingLabel: 'Sending…',
    }),
  );
</script>
