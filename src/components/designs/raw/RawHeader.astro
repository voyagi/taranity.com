---
/**
 * Brutalist masthead: a hard-edged status strip (mono system-readout fields,
 * static — not a marquee), then a sticky nav (wordmark with a blinking cursor
 * block left, slash-prefixed section anchors centre, a bracketed written-contact
 * CTA right). The CTA always reads as "send a message", never "book a call"
 * (hard rule 1). The floating DesignSwitcher carries the cross-design controls.
 */
interface Props {
  /** On subpages, the section anchors point back to the Raw home sections. */
  subpage?: boolean;
}
const { subpage = false } = Astro.props;
const prefix = subpage ? '/raw' : '';
const links = [
  { label: 'Services', hash: '#crafts' },
  { label: 'Method', hash: '#method' },
  { label: 'Studio', hash: '#studio' },
  { label: 'Contact', hash: '#contact' },
];
const statusLeft = ['Taranity', 'Digital studio'];
const statusRight = ['Worldwide', 'Written contact only'];
---

<div class="r-status">
  <ul class="r-status-group" aria-label="Studio">
    {
      statusLeft.map((s, i) => (
        <li>
          {i > 0 && <span class="r-status-sep" aria-hidden="true">/</span>}
          {s}
        </li>
      ))
    }
  </ul>
  <ul class="r-status-group r-status-end" aria-label="How we work">
    {
      statusRight.map((s, i) => (
        <li>
          {i > 0 && <span class="r-status-sep" aria-hidden="true">/</span>}
          {s}
        </li>
      ))
    }
  </ul>
</div>

<header class="r-header">
  <div class="r-header-inner">
    <a class="r-wordmark" href="/raw" aria-label="Taranity home">
      Taranity<span class="r-cursor" aria-hidden="true"></span>
    </a>
    <nav class="r-nav" aria-label="Page sections">
      {
        links.map((l) => (
          <a href={`${prefix}${l.hash}`}>
            <span class="r-nav-slash" aria-hidden="true">/</span>
            {l.label}
          </a>
        ))
      }
    </nav>
    <a class="r-cta r-cta-primary r-header-cta" href={`${prefix}#contact`}>
      <span class="r-bracket" aria-hidden="true">[</span>
      <span class="r-cta-label-full">Start a project</span>
      <span class="r-cta-label-short">Start</span>
      <span class="r-bracket" aria-hidden="true">]</span>
    </a>
  </div>
</header>

<style>
  /* ---- status strip (scrolls away with the page; static, no marquee) ---- */
  .r-status {
    position: relative;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    flex-wrap: wrap;
    padding: 0.4rem var(--r-pad);
    background: var(--r-ink);
    color: var(--r-bg);
    border-bottom: 1.5px solid var(--r-line-hard);
  }
  .r-status-group {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--r-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .r-status-group li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
  }
  .r-status-sep {
    opacity: 0.5;
  }

  /* ---- sticky nav ---- */
  .r-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--r-bg) 85%, transparent);
    border-bottom: 1.5px solid var(--r-line-hard);
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
  }
  .r-header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.7rem var(--r-pad);
  }
  .r-wordmark {
    display: inline-flex;
    align-items: center;
    font-family: var(--r-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--r-ink);
  }
  .r-nav {
    display: flex;
    gap: clamp(0.9rem, 2.4vw, 2rem);
    margin-inline: auto;
  }
  .r-nav a {
    font-family: var(--r-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--r-muted);
  }
  .r-nav-slash {
    color: var(--r-cy);
    margin-right: 0.2rem;
  }
  .r-nav a:hover {
    color: var(--r-ink);
  }
  .r-header-cta {
    padding: 0.5rem 0.85rem;
    font-size: 0.74rem;
    gap: 0.35rem;
  }
  .r-bracket {
    color: var(--r-cy);
    font-weight: 700;
  }
  .r-cta-primary .r-bracket {
    /* on the filled (inverted) button the cyan would vanish; use the bg tone */
    color: color-mix(in srgb, var(--r-cy) 60%, var(--r-bg));
  }
  .r-cta-label-short {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .r-nav a {
      transition: color 0.18s;
    }
  }
  /* Below tablet, drop the section anchors (single scroll, the CTA covers the
     key action) so nothing overflows the narrow header. */
  @media (max-width: 720px) {
    .r-nav {
      display: none;
    }
    .r-header-inner {
      justify-content: space-between;
      gap: 0.75rem;
    }
  }
  @media (max-width: 460px) {
    .r-cta-label-full {
      display: none;
    }
    .r-cta-label-short {
      display: inline;
    }
  }
</style>
