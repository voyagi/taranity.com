---
/**
 * Sign-off footer: the written-contact restated, a journal/privacy link pair,
 * and the legal/GDPR line. Mirrors SheetFooter's content (the words are the
 * contract) restyled to Prism: serif signoff on the section scrim.
 */
import { contactEmail } from '../../../config/site';
const year = new Date().getFullYear();
---

<footer class="pr-footer">
  <p class="pr-signoff">
    Describe it and we spec it back, in plain terms, for free.
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
  </p>
  <nav class="pr-footer-links" aria-label="More from Taranity">
    <a href="/journal">Journal</a>
    <a href="/privacy">Privacy</a>
  </nav>
  <p class="pr-legal">
    © {year} Taranity. A studio in the Netherlands, working with clients worldwide. We
    collect only what you send us and only to reply; you can ask us to delete it any time.
  </p>
</footer>

<style>
  /* The footer is readable content, so it gets the same solid scrim treatment
     as the sections (never bare text over the moving field). */
  .pr-footer {
    margin: var(--pr-flow) var(--pr-gutter) 0;
    padding: clamp(1.6rem, 5vh, 2.4rem) clamp(1.2rem, 3.5vw, 3rem) clamp(2rem, 6vh, 3rem);
    background: var(--pr-scrim);
    border: 1px solid var(--pr-line);
    border-bottom: 0;
  }
  .pr-signoff {
    max-width: 34ch;
    margin: 0 0 1.4rem;
    font-family: var(--pr-serif);
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    line-height: 1.3;
    color: var(--pr-ink);
  }
  .pr-signoff a {
    font-family: var(--pr-grotesk);
    font-size: 0.85em;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-bottom: 1px solid var(--pr-line-strong);
    padding-bottom: 1px;
    white-space: nowrap;
  }
  .pr-signoff a:hover {
    border-color: var(--pr-cyan);
    color: var(--pr-cyan);
  }
  .pr-footer-links {
    display: flex;
    gap: 1.6rem;
    margin-bottom: 1.2rem;
    font-family: var(--pr-grotesk);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .pr-footer-links a {
    color: var(--pr-muted);
    text-decoration: none;
    padding-block: 0.2rem;
  }
  .pr-footer-links a:hover {
    color: var(--pr-ink);
  }
  .pr-legal {
    max-width: 64ch;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--pr-muted);
  }
</style>
