---
/**
 * Page footer, shared by the home experience and the Vitrine subpages
 * (privacy, 404). Kept deliberately small: legal line, design note, privacy.
 */
const year = new Date().getFullYear();
---

<footer class="v-footer">
  <p>© {year} Taranity</p>
  <p class="v-footer-note" aria-hidden="true">Vitrine · a Taranity design language</p>
  <a href="/privacy">Privacy</a>
</footer>

<style>
  .v-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-inline: var(--v-pad);
    padding-block: 1.8rem 2.4rem;
    border-top: 1px solid var(--v-line);
    font-size: 0.78rem;
    color: var(--v-muted);
  }
  .v-footer a {
    color: inherit;
    text-underline-offset: 4px;
  }
  .v-footer a:hover {
    color: var(--v-ink);
  }
</style>
