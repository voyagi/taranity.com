---
/**
 * The point of the studio, stated as an editorial spread, then the way an
 * engagement runs as a numbered index. The crafts themselves live in the
 * plates section; these rows carry the method (copy deliberately does not
 * overlap the studio principles).
 *
 * Copy comes from src/data/vitrine.json (editable at /admin). Each statement
 * line keeps its own `.v-mask` so the [data-v-lines] reveal can stagger them.
 */
import { manifestoContent } from '../../../config/vitrine';
---

<section class="v-manifesto">
  <p class="v-label" data-v-fade>{manifestoContent.label}</p>

  <h2 class="v-statement v-serif" data-v-lines>
    {
      manifestoContent.statementLines.map((line) => (
        <span class="v-mask">
          <span class="v-mask-inner">{line}</span>
        </span>
      ))
    }
  </h2>

  <p class="v-manifesto-copy" data-v-fade>{manifestoContent.copy}</p>

  <ol class="v-capabilities">
    {
      manifestoContent.method.map((step) => (
        <li class="v-cap" data-v-fade>
          <span class="v-cap-index v-serif" aria-hidden="true">{step.index}</span>
          <h3 class="v-cap-name v-serif">{step.name}</h3>
          <p class="v-cap-line">{step.line}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .v-manifesto {
    padding: var(--v-section) var(--v-pad);
  }
  .v-statement {
    margin-block: clamp(1.8rem, 4vh, 2.8rem) clamp(2rem, 5vh, 3rem);
    font-size: clamp(2rem, 5.4vw, 5.2rem);
    font-weight: 400;
    line-height: 1.06;
  }
  .v-manifesto-copy {
    max-width: 56ch;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--v-muted);
  }
  .v-capabilities {
    margin: clamp(3.5rem, 9vh, 5.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .v-cap {
    display: grid;
    grid-template-columns: 4.5rem 1fr 1.4fr;
    gap: 1rem 2rem;
    align-items: baseline;
    padding-block: clamp(1.3rem, 3vh, 1.9rem);
    border-top: 1px solid var(--v-line);
  }
  .v-cap:last-child {
    border-bottom: 1px solid var(--v-line);
  }
  .v-cap-index {
    font-size: 1rem;
    color: var(--v-muted);
  }
  .v-cap-name {
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    font-weight: 420;
  }
  .v-cap-line {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--v-muted);
  }
  @media (max-width: 720px) {
    .v-cap {
      grid-template-columns: 3rem 1fr;
    }
    .v-cap-line {
      grid-column: 2;
    }
  }
</style>
