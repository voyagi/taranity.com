---
/**
 * Vitrine — the flagship design. Luxury editorial: oversized serif, hairline
 * rules, full-bleed art plates, slow cinematic scroll. One self-contained
 * page experience; SiteLayout provides head/meta and the floating switcher.
 */
import './vitrine.css';
import VitrineHeader from './VitrineHeader.astro';
import VitrineHero from './VitrineHero.astro';
import VitrineManifesto from './VitrineManifesto.astro';
import VitrineCrafts from './VitrineCrafts.astro';
import VitrineStudio from './VitrineStudio.astro';
import VitrineMarquee from './VitrineMarquee.astro';
import VitrineContact from './VitrineContact.astro';
import VitrineFooter from './VitrineFooter.astro';
---

<div class="vitrine" data-vitrine>
  <!-- Two atmospheres behind everything, fixed so the page scrolls past them:
       a night sky for dark mode (--v-stars) and sunlit paper for light mode
       (--v-paper). The mode toggle crossfades between them. -->
  <div class="v-stars" aria-hidden="true"><i></i><i></i></div>
  <div class="v-paper" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  <!-- Scroll position indicator: replaces the native scrollbar, which is
       hidden only while Lenis drives the scroll (html.v-lenis). -->
  <span class="v-progress" data-v-progress aria-hidden="true"></span>
  <VitrineHeader />
  <VitrineHero />
  <VitrineManifesto />
  <VitrineCrafts />
  <VitrineStudio />
  <VitrineMarquee />
  <VitrineContact />
  <VitrineFooter />
</div>

<script>
  import '../../../lib/vitrine-motion';
</script>
