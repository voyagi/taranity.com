---
/**
 * Full-viewport editorial opening. The statement leads with what the work is
 * for (being remembered, results), never with the tooling. Server-rendered
 * and fully visible without JS; motion only adds the entrance.
 *
 * Copy comes from src/data/vitrine.json (editable at /admin). Each title line
 * becomes its own `.v-mask` so the hero timeline can rise them out one by one;
 * the final line is set lighter (the em treatment) as the closing payoff.
 */
import { heroContent } from '../../../config/vitrine';
---

<section class="v-hero">
  <p class="v-label v-hero-kicker" data-v-hero-fade>{heroContent.kicker}</p>

  <h1 class="v-hero-title v-serif">
    {
      heroContent.titleLines.map((line, i) => (
        <span class="v-mask">
          <span class="v-mask-inner">
            {i === heroContent.titleLines.length - 1 ? <em>{line}</em> : line}
          </span>
        </span>
      ))
    }
  </h1>

  <div class="v-hero-foot">
    <p class="v-hero-sub" data-v-hero-fade>{heroContent.sub}</p>
    <p class="v-hero-scroll" data-v-hero-fade aria-hidden="true">
      Scroll<span class="v-hero-scroll-line"></span>
    </p>
  </div>

  <span class="v-rule" data-v-hero-rule aria-hidden="true"></span>
</section>

<style>
  .v-hero {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: clamp(6rem, 14vh, 9rem) var(--v-pad) clamp(1.8rem, 4vh, 3rem);
    /* A quiet pool of warmth so the negative space reads intentional. Fixed
       bronze (not the accent token): it reads correctly over both paper and
       near-black, and a constant gradient cannot snap when the mode flips
       (background-image does not transition; the page colour beneath does). */
    background: radial-gradient(46% 58% at 76% 22%, rgba(198, 160, 105, 0.1), transparent 72%);
  }
  .v-hero-kicker {
    color: var(--v-muted);
  }
  .v-hero-title {
    margin-block: auto;
    font-size: clamp(3.4rem, 12.5vw, 13rem);
    font-weight: 360;
    line-height: 0.93;
    letter-spacing: -0.015em;
  }
  .v-hero-title em {
    font-style: normal;
    font-weight: 250;
  }
  .v-hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.6rem, 4vh, 2.6rem);
  }
  .v-hero-sub {
    max-width: 44ch;
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.65;
    color: var(--v-muted);
  }
  .v-hero-scroll {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.66rem;
    font-weight: 540;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--v-muted);
    white-space: nowrap;
  }
  .v-hero-scroll-line {
    width: clamp(2.6rem, 7vw, 5.5rem);
    height: 1px;
    background: var(--v-line-strong);
  }
  @media (max-width: 640px) {
    .v-hero-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.4rem;
    }
  }
</style>
