---
/**
 * The studio, told briefly: where the habit of replacing manual work came
 * from, and the principles the work is held to. A tonal band (deeper paper /
 * lifted black) separates it from the work gallery.
 *
 * Copy comes from src/data/vitrine.json (editable at /admin). The story is an
 * array of paragraphs; each keeps its own data-v-fade so it rises in on scroll.
 */
import { studioContent } from '../../../config/vitrine';
---

<section class="v-studio v-tonal" id="studio" tabindex="-1">
  <h2 class="v-sr">The studio</h2>
  <p class="v-label" data-v-fade>{studioContent.label}</p>

  <div class="v-studio-grid">
    <div class="v-studio-story">
      <p class="v-studio-lede v-serif" data-v-fade>{studioContent.lede}</p>
      {studioContent.story.map((para) => <p data-v-fade>{para}</p>)}
    </div>

    <ul class="v-principles">
      {
        studioContent.principles.map((p) => (
          <li class="v-principle" data-v-fade>
            <h3 class="v-principle-title v-serif">{p.title}</h3>
            <p class="v-principle-body">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .v-studio {
    padding: var(--v-section) var(--v-pad);
    background: var(--v-bg-deep);
    border-block: 1px solid var(--v-line);
  }
  .v-studio:focus {
    outline: none;
  }
  .v-studio-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(3rem, 7vw, 6.5rem);
    margin-top: clamp(2rem, 5vh, 3rem);
  }
  .v-studio-lede {
    margin-bottom: clamp(1.5rem, 4vh, 2.2rem);
    font-size: clamp(2rem, 4.2vw, 3.8rem);
    font-weight: 400;
    line-height: 1.1;
  }
  .v-studio-story p:not(.v-studio-lede) {
    max-width: 58ch;
    margin-bottom: 1.2rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--v-muted);
  }
  .v-principles {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .v-principle {
    padding-block: clamp(1.2rem, 3vh, 1.7rem);
    border-top: 1px solid var(--v-line);
  }
  .v-principle:last-child {
    border-bottom: 1px solid var(--v-line);
  }
  .v-principle-title {
    margin-bottom: 0.45rem;
    font-size: 1.25rem;
    font-weight: 480;
  }
  .v-principle-body {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--v-muted);
  }
  @media (max-width: 860px) {
    .v-studio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
