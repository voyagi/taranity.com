---
/**
 * Editorial masthead: wordmark left, section anchors right. Sits over the
 * hero and scrolls away with it (single-page experience; the floating
 * DesignSwitcher carries the persistent controls).
 */
---

<header class="v-header">
  <a class="v-wordmark" href="/" aria-label="Taranity home">Taranity</a>
  <nav class="v-nav" aria-label="Page sections">
    <a href="#crafts">Crafts</a>
    <a href="#studio">Studio</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<style>
  .v-header {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.2rem, 3.5vh, 2.2rem) var(--v-pad);
  }
  .v-wordmark {
    font-size: 0.82rem;
    font-weight: 620;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .v-nav {
    display: flex;
    gap: clamp(1.1rem, 3vw, 2.4rem);
  }
  .v-nav a {
    font-size: 0.7rem;
    font-weight: 540;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--v-muted);
  }
  .v-nav a:hover {
    color: var(--v-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .v-nav a {
      transition: color 0.25s;
    }
  }
  @media (max-width: 480px) {
    .v-wordmark {
      letter-spacing: 0.22em;
    }
    .v-nav {
      gap: 0.9rem;
    }
    .v-nav a {
      font-size: 0.64rem;
      letter-spacing: 0.16em;
    }
  }
</style>
