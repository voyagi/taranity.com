---
/**
 * Editorial masthead: the brand lockup left, section anchors right. Sits over
 * the hero and scrolls away with it (single-page experience; the floating
 * DesignSwitcher carries the persistent controls). On subpages (privacy,
 * 404) the anchors point back into the home experience.
 */
import BrandLockup from '../../BrandLockup.astro';

interface Props {
  /** Subpages link to the home sections instead of in-page anchors. */
  subpage?: boolean;
}
const { subpage = false } = Astro.props;
const prefix = subpage ? '/' : '';
---

<header class="v-header">
  <a class="v-wordmark" href="/" aria-label="Taranity home">
    <BrandLockup height="var(--v-lockup)" label="" />
  </a>
  <nav class="v-nav" aria-label="Page sections">
    <a href={`${prefix}#crafts`}>Crafts</a>
    <a href={`${prefix}#studio`}>Studio</a>
    <a href={`${prefix}#contact`}>Contact</a>
  </nav>
</header>

<style>
  .v-header {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.2rem, 3.5vh, 2.2rem) var(--v-pad);
    --v-lockup: 1.5rem;
  }
  .v-wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .v-nav {
    display: flex;
    gap: clamp(1.1rem, 3vw, 2.4rem);
  }
  .v-nav a {
    font-size: 0.7rem;
    font-weight: 540;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--v-muted);
  }
  .v-nav a:hover {
    color: var(--v-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .v-nav a {
      transition: color 0.25s;
    }
  }
  @media (max-width: 480px) {
    .v-header {
      --v-lockup: 1.25rem;
    }
    .v-nav {
      gap: 0.9rem;
    }
    .v-nav a {
      font-size: 0.64rem;
      letter-spacing: 0.16em;
    }
  }
</style>
