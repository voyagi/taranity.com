---
/**
 * Editorial masthead: the brand lockup left, section anchors right. Sits over
 * the hero and scrolls away with it (single-page experience; the floating
 * DesignSwitcher carries the persistent controls). On subpages (privacy,
 * 404) the anchors point back into the home experience.
 *
 * Below 400 px the full lockup and the three anchors do not fit one row
 * (the design clips horizontal overflow, so the last anchor would be cut),
 * so the link carries the compact tile alone there. Both variants are in the
 * markup and CSS shows one, which keeps the switch free of script.
 */
import BrandLockup from '../../BrandLockup.astro';

interface Props {
  /** Subpages link to the home sections instead of in-page anchors. */
  subpage?: boolean;
}
const { subpage = false } = Astro.props;
const prefix = subpage ? '/' : '';
---

<header class="v-header">
  <a class="v-wordmark" href="/" aria-label="Taranity home">
    <BrandLockup class="v-lockup-full" height="var(--v-lockup)" label="" />
    <BrandLockup class="v-lockup-tile" variant="tile" height="var(--v-lockup)" label="" />
  </a>
  <nav class="v-nav" aria-label="Page sections">
    <a href={`${prefix}#crafts`}>Crafts</a>
    <a href={`${prefix}#studio`}>Studio</a>
    <a href={`${prefix}#contact`}>Contact</a>
  </nav>
</header>

<style>
  .v-header {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.2rem, 3.5vh, 2.2rem) var(--v-pad);
    --v-lockup: 1.5rem;
  }
  .v-wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    /* The mark's dress in this design. The tile is the page inverted, so the
       full stop follows it: brass on the dark tile, bronze on the paper one. */
    --brand-ink: var(--v-ink);
    --brand-bg: var(--v-bg);
    --brand-period: #c9a36a;
  }
  :global(:root[data-mode='dark']) .v-wordmark {
    --brand-period: #7d5f35;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-mode])) .v-wordmark {
      --brand-period: #7d5f35;
    }
  }
  .v-wordmark :global(.v-lockup-tile) {
    display: none;
  }
  .v-nav {
    display: flex;
    gap: clamp(1.1rem, 3vw, 2.4rem);
  }
  .v-nav a {
    font-size: 0.7rem;
    font-weight: 540;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--v-muted);
  }
  .v-nav a:hover {
    color: var(--v-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .v-nav a {
      transition: color 0.25s;
    }
  }
  @media (max-width: 480px) {
    .v-header {
      --v-lockup: 1.25rem;
    }
    .v-nav {
      gap: 0.9rem;
    }
    .v-nav a {
      font-size: 0.64rem;
      letter-spacing: 0.16em;
    }
  }
  @media (max-width: 400px) {
    .v-header {
      --v-lockup: 1.6rem;
    }
    .v-wordmark :global(.v-lockup-full) {
      display: none;
    }
    .v-wordmark :global(.v-lockup-tile) {
      display: inline-flex;
    }
  }
</style>
