---
/**
 * Ink - the hand-drawn monochrome design. The hero is a LITERAL reproduction
 * of the approved mockup (.ink-approved-mockup.html): the two ink characters,
 * the stacked wordmark, the top-right note, the grey kicker, the giant Besley
 * slab word, the dot, and the black curved edge blob with the burger. Below,
 * the hellomonday-style recipe: a jump-ahead line, five two-column service
 * sections (a NEW ink vignette per service, drawn in the approved naive
 * style), the approach, contact, and a sign-off footer.
 *
 * The whole server HTML is complete without JS: the slab shows the first
 * word, the menu overlay stays hidden (every menu target is also reachable
 * in the page flow or footer), and the jump-ahead anchors are plain links.
 * The bundled island (src/lib/ink-hero.ts) adds the word rotation and the
 * blob menu behaviour; it is strictly additive. Native scroll only.
 *
 * The five service sections are written out one by one (not mapped): each
 * carries its own bespoke vignette drawing, and the fixed order/anchors are
 * design, so the explicit unroll IS the source of truth the eye can check.
 */
import './ink.css';
import { HERO_WORDS } from '../../../lib/ink-hero';
import { heroContent, servicesKicker, services, approachContent } from '../../../config/ink';
import InkContact from './InkContact.astro';
import InkFooter from './InkFooter.astro';

// The h1's accessible name: one stable sentence naming all five nouns, so the
// rotating (aria-hidden) word never changes what assistive tech announces.
const srSentence = HERO_WORDS.map((w, i) => (i === 0 ? w : w.toLowerCase())).join(', ') + '.';
const firstWord = HERO_WORDS[0];

// The loader guarantees this exact code-owned order (derived from HERO_WORDS).
const [websites, stores, apps, automation, systems] = services;
---

<div class="ink" data-ink>
  <!-- 1. Hero: the approved mockup, exactly. -->
  <section class="ik-hero" aria-label="Taranity, a digital build studio">
    <a class="ik-logo ik-hero-logo" href="/" aria-label="Taranity home">TARANITY<br />/STUDIO.</a>
    <p class="ik-tag">{heroContent.tagLead} <b>{heroContent.tagStrong}</b></p>

    <div class="ik-stage">
      <!-- The two approved ink-drawn characters, naive single-weight strokes
           (the human "thing"). Paths verbatim from the approved mockup. -->
      <svg viewBox="0 0 460 470" fill="none" aria-hidden="true">
