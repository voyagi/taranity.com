---
/**
 * Written contact only (hard rule: no booking, no calls): a short form and a
 * direct email address. Submission uses the same-origin contact API, which
 * verifies Turnstile server-side before forwarding to Web3Forms; the client
 * keeps a hardcoded endpoint, honeypot, and inline validation, restyled for
 * Atlas.
 */
import { services, socials, contactEmail } from '../../../config/site';

const hasTurnstile = Boolean(services.turnstileSitekey);
---

<section class="a-section a-contact" id="contact" tabindex="-1">
  <p class="a-label" data-a-fade>05 · Contact</p>

  <h2 class="a-statement a-display" data-a-lines>
    <span class="a-mask"><span class="a-mask-inner">Send the</span></span>
    <span class="a-mask"><span class="a-mask-inner">coordinates.</span></span>
  </h2>

  <div class="a-contact-grid">
    <div class="a-contact-aside" data-a-fade>
      <p class="a-contact-lead">
        Tell us what you are building and where it needs to land. We read
        everything and reply within a day, in writing.
      </p>
      <a class="a-contact-email a-display" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <p class="a-contact-loc">Working with clients worldwide</p>
      <ul class="a-contact-socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="a-form-wrap" data-a-fade>
      <form
        class="a-form"
        data-a-form
        data-fallback-email={contactEmail}
        action="/api/contact"
        method="POST"
        novalidate
      >
        <input type="hidden" name="subject" value="New enquiry via taranity.com (Atlas)" />
        <input type="hidden" name="from_name" value="taranity.com" />
        <!-- Honeypot -->
        <input type="checkbox" name="botcheck" class="a-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        {
          !hasTurnstile && (
            <p class="a-demo-note">Demo mode: submissions are simulated in this preview.</p>
          )
        }

        <div class="a-field-row">
          <label for="a-name">Name</label>
          <input id="a-name" name="name" type="text" required maxlength="100" autocomplete="name" aria-describedby="a-err-name" />
          <span class="a-field-err" id="a-err-name" data-a-err="name" role="alert"></span>
        </div>

        <div class="a-field-row">
          <label for="a-email">Email</label>
          <input id="a-email" name="email" type="email" required maxlength="150" autocomplete="email" aria-describedby="a-err-email" />
          <span class="a-field-err" id="a-err-email" data-a-err="email" role="alert"></span>
        </div>

        <div class="a-field-row">
          <label for="a-message">Message</label>
          <textarea id="a-message" name="message" rows="5" required maxlength="3000" aria-describedby="a-err-message"></textarea>
          <span class="a-field-err" id="a-err-message" data-a-err="message" role="alert"></span>
        </div>

        {hasTurnstile && (
          <Fragment>
            <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
            <div class="cf-turnstile" data-sitekey={services.turnstileSitekey} data-action="turnstile-spin-v1" data-theme="auto" style="margin-bottom: 1.5rem"></div>
          </Fragment>
        )}

        <button type="submit" class="a-submit">
          <span data-a-submit-label>Transmit</span>
          <span class="a-submit-line" aria-hidden="true"></span>
        </button>

        <p class="a-form-status" data-a-form-status role="status" aria-live="polite"></p>
        <p class="a-form-privacy">
          Delivered via Web3Forms and used only to reply. No cookies, nothing
          sold. <a href="/privacy" data-astro-reload>How your data is handled</a>.
        </p>
      </form>

      <div class="a-form-success" data-a-form-success hidden tabindex="-1">
        <h3 class="a-display">Received.</h3>
        <p>Thank you. We reply within a day, usually sooner, and always in writing.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .a-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(3rem, 7vw, 6.5rem);
    align-items: start;
    margin-bottom: clamp(3.5rem, 9vh, 6rem);
  }
  .a-contact-lead {
    max-width: 38ch;
    margin-bottom: clamp(1.8rem, 5vh, 2.6rem);
    font-size: 1.04rem;
    line-height: 1.7;
    color: var(--a-muted);
  }
  .a-contact-email {
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    font-weight: 500;
    text-decoration-thickness: 1px;
    text-underline-offset: 8px;
  }
  .a-contact-loc {
    margin-top: 0.9rem;
    font-family: var(--a-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--a-muted);
  }
  .a-contact-socials {
    display: flex;
    gap: 1.6rem;
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .a-contact-socials a {
    font-family: var(--a-mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--a-muted);
  }
  .a-contact-socials a:hover {
    color: var(--a-ink);
  }

  /* Form: instrument-panel fields on hairlines, capped to a humane measure. */
  .a-form-wrap {
    max-width: 680px;
  }
  .a-hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }
  .a-demo-note {
    margin-bottom: 1.6rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--a-line);
    font-size: 0.8rem;
    color: var(--a-accent);
  }
  .a-field-row {
    margin-bottom: 1.7rem;
  }
  .a-field-row label {
    display: block;
    margin-bottom: 0.55rem;
    font-family: var(--a-mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--a-muted);
  }
  .a-field-row input,
  .a-field-row textarea {
    width: 100%;
    padding: 0.45rem 0 0.75rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--a-line-strong);
    border-radius: 0;
    font-size: 1.05rem;
    color: var(--a-ink);
  }
  .a-field-row textarea {
    resize: vertical;
    min-height: 110px;
  }
  .a-field-row input:focus-visible,
  .a-field-row textarea:focus-visible {
    outline: none;
    border-bottom: 2px solid var(--a-accent);
    padding-bottom: calc(0.75rem - 1px);
  }
  .a-field-row.invalid input,
  .a-field-row.invalid textarea {
    border-bottom-color: var(--a-error);
  }
  .a-field-err {
    display: block;
    min-height: 1rem;
    margin-top: 0.45rem;
    font-size: 0.78rem;
    color: var(--a-error);
  }

  .a-submit {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.4rem;
    padding: 1rem 2.1rem;
    border: 1px solid var(--a-line-strong);
    background: transparent;
    font-family: var(--a-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--a-ink);
    cursor: pointer;
  }
  .a-submit-line {
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  .a-submit:hover {
    background: var(--a-accent);
    border-color: var(--a-accent);
    color: #04121f;
  }
  .a-submit[disabled] {
    opacity: 0.55;
    cursor: progress;
  }
  @media (prefers-reduced-motion: no-preference) {
    .a-submit {
      transition: background-color 0.3s, color 0.3s, border-color 0.3s;
    }
    .a-submit-line {
      transition: width 0.3s;
    }
    .a-submit:hover .a-submit-line {
      width: 3rem;
    }
  }

  .a-form-status {
    min-height: 1rem;
    margin-top: 1rem;
    font-size: 0.85rem;
  }
  .a-form-status.is-error {
    color: var(--a-error);
  }
  .a-form-privacy {
    margin-top: 1.3rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--a-muted);
  }
  .a-form-privacy a {
    color: inherit;
  }

  .a-form-success:focus {
    outline: none;
  }
  .a-form-success h3 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 0.8rem;
  }
  .a-form-success p {
    max-width: 40ch;
    color: var(--a-muted);
    line-height: 1.7;
  }
  .a-form-success[hidden] {
    display: none;
  }

  @media (max-width: 860px) {
    .a-contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { bindContactForm } from '../../../lib/contact-form';

  document.addEventListener('astro:page-load', () =>
    bindContactForm({
      formSelector: '[data-a-form]',
      statusSelector: '[data-a-form-status]',
      submitButtonSelector: '.a-submit',
      submitLabelSelector: '[data-a-submit-label]',
      successSelector: '[data-a-form-success]',
      wrapperSelector: '.a-form-wrap',
      fieldRowSelector: '.a-field-row',
      errorAttr: 'data-a-err',
      sendingLabel: 'Transmitting…',
    }),
  );
</script>
