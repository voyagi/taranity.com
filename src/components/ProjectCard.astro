---
import type { Project } from '../content/projects';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  /** Display index, e.g. "01". */
  index: string;
  variant?: 'grid' | 'panel';
}
const { project, index, variant = 'grid' } = Astro.props;
const href = `/projects/${project.slug}`;
---

<a
  href={href}
  class:list={['pcard glass holo-edge', `accent-${project.accent}`, `is-${variant}`]}
  data-cursor="view"
  data-cursor-text="open"
>
  <div class="pcard-top">
    <span class="pcard-index mono-label">{index} / {project.category}</span>
    <span class="pcard-year mono-label">{project.year}</span>
  </div>

  <div class="pcard-body">
    <h3 class="pcard-title" transition:name={`project-title-${project.slug}`}>
      {project.title}
    </h3>
    <p class="pcard-summary">{project.summary}</p>
  </div>

  <div class="pcard-foot">
    <div class="pcard-metric">
      <span class="pcard-metric-value gradient-text">{project.headlineMetric.value}</span>
      <span class="pcard-metric-label">{project.headlineMetric.label}</span>
    </div>
    <span class="pcard-open">
      open
      <Icon name="arrow-up-right" size={16} class="arrow" />
    </span>
  </div>

  <span class="pcard-rule" transition:name={`project-rule-${project.slug}`}></span>
</a>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.6rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    min-height: 320px;
    overflow: hidden;
    transition: transform 0.4s var(--ease-out-expo), border-color 0.3s;
    isolation: isolate;
  }
  .pcard:hover { transform: translateY(-5px); }
  .pcard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pcard-body { margin-top: auto; }
  .pcard-title {
    font-size: var(--text-h3);
    line-height: 1.1;
    margin-bottom: 0.6rem;
  }
  .pcard-summary {
    color: var(--color-ink-dim);
    font-size: 0.98rem;
    line-height: 1.55;
    max-width: 42ch;
  }
  .pcard-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-line);
  }
  .pcard-metric { display: flex; flex-direction: column; gap: 0.15rem; }
  .pcard-metric-value {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.2rem);
    line-height: 1;
  }
  .pcard-metric-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .pcard-open {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cyan);
  }
  /* Accent glow on hover, per project */
  .pcard.accent-cyan:hover { box-shadow: var(--shadow-glow-cyan); }
  .pcard.accent-violet:hover { box-shadow: var(--shadow-glow-violet); }

  .pcard-rule {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--grad-holo);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out-expo);
  }
  .pcard:hover .pcard-rule { transform: scaleX(1); }

  /* Panel variant for the horizontal gallery */
  .pcard.is-panel {
    min-height: min(64vh, 520px);
    justify-content: flex-end;
  }
  .pcard.is-panel .pcard-title { font-size: var(--text-h2); }
  .pcard.is-panel .pcard-summary { font-size: 1.05rem; max-width: 48ch; }
</style>
