---
interface Props {
  value: string;
  label: string;
  /** If set, the number counts up on scroll-in (use for clean integers). */
  count?: number;
  prefix?: string;
  suffix?: string;
}
const { value, label, count, prefix = '', suffix = '' } = Astro.props;
---

<div class="metric glass holo-edge" data-reveal>
  <span class="metric-value gradient-text">
    {
      count !== undefined ? (
        <span data-count={count} data-count-prefix={prefix} data-count-suffix={suffix}>
          {value}
        </span>
      ) : (
        value
      )
    }
  </span>
  <span class="metric-label">{label}</span>
</div>

<style>
  .metric {
    padding: clamp(1.3rem, 3vw, 1.8rem);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .metric-value {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
    line-height: 1;
  }
  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
  }
</style>
