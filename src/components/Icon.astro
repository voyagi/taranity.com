---
/**
 * Custom geometric line-icon set. No emoji, no icon font.
 * 24px grid, 1.5px stroke, currentColor, round caps.
 */
interface Props {
  name:
    | 'arrow-right'
    | 'arrow-up-right'
    | 'arrow-left'
    | 'search'
    | 'menu'
    | 'mail'
    | 'calendar'
    | 'github'
    | 'linkedin'
    | 'x'
    | 'terminal'
    | 'sun'
    | 'moon'
    | 'palette';
  class?: string;
  size?: number;
}
const { name, class: className = '', size = 24 } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.5,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': true,
  class: className,
};
---

{name === 'arrow-right' && <svg {...common}><path d="M4 12h15M13 6l6 6-6 6" /></svg>}
{name === 'arrow-left' && <svg {...common}><path d="M20 12H5M11 18l-6-6 6-6" /></svg>}
{name === 'arrow-up-right' && <svg {...common}><path d="M7 17 17 7M8 7h9v9" /></svg>}
{name === 'search' && <svg {...common}><circle cx="11" cy="11" r="7" /><path d="m20 20-3.2-3.2" /></svg>}
{name === 'menu' && <svg {...common}><path d="M4 7h16M4 12h16M4 17h16" /></svg>}
{name === 'mail' && <svg {...common}><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>}
{name === 'calendar' && <svg {...common}><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 9h18M8 3v4M16 3v4" /></svg>}
{name === 'github' && (
  <svg {...common}>
    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
  </svg>
)}
{name === 'linkedin' && (
  <svg {...common}><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 17v-7" /></svg>
)}
{name === 'x' && <svg {...common}><path d="M4 4l16 16M20 4 4 20" /></svg>}
{name === 'terminal' && <svg {...common}><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 3 3-3 3M13 15h4" /></svg>}
{name === 'sun' && <svg {...common}><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" /></svg>}
{name === 'moon' && <svg {...common}><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>}
{name === 'palette' && <svg {...common}><circle cx="12" cy="12" r="9" /><circle cx="8.5" cy="10" r="1" /><circle cx="15.5" cy="10" r="1" /><circle cx="12" cy="15.5" r="1" /></svg>}
