---
/**
 * The brand lockup: the "ta." compact mark beside the lowercase wordmark, as
 * one inline SVG. Every letter is a vector outline (drawn from Fraunces, the
 * site's display face), so no font has to load before the mark is right.
 *
 * Colours are inherited, never owned here: a design sets --brand-ink (the
 * solid tile), --brand-bg (the letters knocked out of it) and --brand-period
 * (the full stop) on the element that wraps the mark, so every design dresses
 * the same geometry in its own palette. The Vitrine values are the fallback.
 * Fixed surfaces such as the Open Graph cards pass explicit colours instead.
 *
 * Two variants share the same colours: the full lockup, and the tile alone
 * for spaces too narrow for the name (the phone header at 320 px).
 *
 * The masters live in src/assets/brand/ with three placeholder colours
 * (INK_TOKEN, BG_TOKEN, ACCENT_TOKEN) that this component maps.
 */
import lockupRaw from '../assets/brand/lockup-inline.svg?raw';
import tileRaw from '../assets/brand/tile-inline.svg?raw';

interface Props {
  /** CSS height of the mark; width follows the aspect ratio. */
  height?: string;
  /** 'lockup' (tile and wordmark, default) or 'tile' (the compact mark alone). */
  variant?: 'lockup' | 'tile';
  /** Explicit colours for surfaces without tokens (hex). Omit to follow the design. */
  ink?: string;
  bg?: string;
  accent?: string;
  /** Accessible name. Pass an empty string when a parent link already names it. */
  label?: string;
  class?: string;
}

const { height = '1.5rem', variant = 'lockup', ink, bg, accent, label = 'Taranity', class: className = '' } = Astro.props;

/**
 * Escape a value for use inside a double-quoted HTML attribute. The label is
 * interpolated into raw SVG markup rendered with set:html, so a quote in it
 * would otherwise end the attribute early.
 */
const escapeAttribute = (value: string): string =>
  value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const a11y = label ? `role="img" aria-label="${escapeAttribute(label)}"` : 'aria-hidden="true" focusable="false"';
const raw = variant === 'tile' ? tileRaw : lockupRaw;
const svg = raw
  .replace(/INK_TOKEN/g, ink ?? 'var(--brand-ink, #1a1712)')
  .replace(/BG_TOKEN/g, bg ?? 'var(--brand-bg, #f4f0e8)')
  .replace(/ACCENT_TOKEN/g, accent ?? 'var(--brand-period, #c9a36a)')
  .replace('<svg ', `<svg ${a11y} `);
---

<span class={`brand-lockup ${className}`.trim()} style={`--brand-h:${height}`} set:html={svg} />

<style>
  .brand-lockup {
    display: inline-flex;
    line-height: 0;
  }
  .brand-lockup :global(svg) {
    display: block;
    height: var(--brand-h);
    width: auto;
  }
</style>
