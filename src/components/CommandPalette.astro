---
import { nav, socials, cta, contactEmail } from '../config/site';
import { orderedProjects } from '../content/projects';

const bookingExternal = /^https?:\/\//.test(cta.primaryHref);
---

<div
  class="palette"
  data-palette
  data-open="false"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Command palette"
>
  <div class="palette-dialog glass-strong" data-palette-dialog>
    <div class="palette-search">
      <span class="prompt" aria-hidden="true">&gt;</span>
      <input
        type="text"
        data-palette-input
        placeholder="Jump to a page, project, or action…"
        aria-label="Search commands"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>esc</kbd>
    </div>

    <div class="palette-list" data-palette-list role="listbox" aria-label="Commands">
      <section data-cmd-group>
        <p class="palette-group mono-label">Navigate</p>
        <a class="cmd" data-cmd href="/" data-keywords="home start index landing" data-astro-reload>
          <span data-cmd-label>Home</span><span class="cmd-meta">/</span>
        </a>
        {
          nav.map((item) => (
            <a class="cmd" data-cmd href={item.href} data-keywords={`${item.label} page ${item.href}`}>
              <span data-cmd-label>{item.label}</span>
              <span class="cmd-meta">{item.href}</span>
            </a>
          ))
        }
      </section>

      <section data-cmd-group>
        <p class="palette-group mono-label">Projects</p>
        {
          orderedProjects.map((p) => (
            <a
              class="cmd"
              data-cmd
              href={`/projects/${p.slug}`}
              data-keywords={`${p.title} ${p.tags.join(' ')} ${p.category} case study project`}
            >
              <span data-cmd-label>{p.title}</span>
              <span class="cmd-meta">{p.category}</span>
            </a>
          ))
        }
      </section>

      <section data-cmd-group>
        <p class="palette-group mono-label">Actions</p>
        <a
          class="cmd"
          data-cmd
          href={cta.primaryHref}
          data-external={bookingExternal ? 'true' : 'false'}
          data-keywords="book call meeting schedule calendar booking hire"
        >
          <span data-cmd-label>{cta.primaryLabel}</span><span class="cmd-meta">↵</span>
        </a>
        <a class="cmd" data-cmd href="/contact" data-keywords="contact start project email message form hire">
          <span data-cmd-label>Start a project</span><span class="cmd-meta">/contact</span>
        </a>
        <button
          class="cmd"
          type="button"
          data-cmd
          data-action="copy-email"
          data-value={contactEmail}
          data-keywords="copy email address mail"
        >
          <span data-cmd-label>Copy email</span><span class="cmd-meta">{contactEmail}</span>
        </button>
      </section>

      <section data-cmd-group>
        <p class="palette-group mono-label">Elsewhere</p>
        {
          socials.map((s) => (
            <a class="cmd" data-cmd href={s.href} data-external="true" data-keywords={s.keywords}>
              <span data-cmd-label>{s.label}</span>
              <span class="cmd-meta">↗</span>
            </a>
          ))
        }
      </section>

      <p class="palette-empty mono-label" data-palette-empty style="display:none">No matches.</p>
    </div>

    <div class="palette-foot">
      <span class="mono-label"><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span class="mono-label"><kbd>↵</kbd> open</span>
      <span class="mono-label"><kbd>esc</kbd> close</span>
    </div>
  </div>
</div>

<style>
  .palette {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: start center;
    padding-top: 14vh;
    background: var(--palette-bg);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s var(--ease-out-expo), visibility 0.2s;
  }
  .palette[data-open='true'] { opacity: 1; visibility: visible; }
  .palette-dialog {
    width: min(620px, 92vw);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: var(--shadow-panel);
    transform: translateY(-8px) scale(0.99);
    transition: transform 0.25s var(--ease-out-expo);
  }
  .palette[data-open='true'] .palette-dialog { transform: none; }

  .palette-search {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--color-line);
  }
  .palette-search .prompt { font-family: var(--font-mono); color: var(--color-cyan); font-size: 1rem; }
  .palette-search input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .palette-search input::placeholder { color: var(--color-ink-faint); }
  .palette-search kbd, .palette-foot kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-ink-faint);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
  }

  .palette-list { overflow-y: auto; padding: 0.6rem; }
  .palette-group { padding: 0.7rem 0.6rem 0.3rem; }
  .cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    text-align: left;
    gap: 1rem;
    padding: 0.65rem 0.7rem;
    border-radius: 0.6rem;
    color: var(--color-ink-dim);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    font-family: inherit;
  }
  .cmd [data-cmd-label] { color: var(--color-ink); }
  .cmd .cmd-meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-ink-faint); }
  .cmd.is-active { background: rgba(var(--accent-rgb), 0.1); }
  .cmd.is-active .cmd-meta { color: var(--color-cyan); }

  .palette-foot {
    display: flex;
    gap: 1.2rem;
    padding: 0.7rem 1.2rem;
    border-top: 1px solid var(--color-line);
  }
  .palette-foot .mono-label { display: inline-flex; align-items: center; gap: 0.3rem; }
  .palette-empty { padding: 1.4rem 0.7rem; }
</style>
