---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Chrome from '../components/Chrome.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, services, socials, contactEmail } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** OG image path relative to site root. */
  image?: string;
  /** "website" | "article". */
  type?: string;
  noindex?: boolean;
  /** Extra JSON-LD injected for this page (object or array of objects). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = '/og.png',
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = new URL(image, site.url);
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: contactEmail,
  description: site.description,
  slogan: site.shortTagline,
  logo: new URL('/apple-touch-icon.png', site.url).href,
  founder: { '@type': 'Person', name: site.founder },
  address: { '@type': 'PostalAddress', addressLocality: 'Eindhoven', addressCountry: 'NL' },
  knowsAbout: [
    'AI systems',
    'LLM agents',
    'Model Context Protocol',
    'Web development',
    'App development',
    'Workflow automation',
    'Full-stack development',
    'TypeScript',
  ],
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f4ff" />

    <!-- Preload the two LCP-critical fonts (display + body) -->
    <link rel="preload" href="/fonts/space-grotesk-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons + PWA manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd).replace(/</g, '\\u003c')} />
    {
      jsonLd &&
        (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((ld) => (
          <script is:inline type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
        ))
    }

    <!-- Pre-paint: set .js (avoids reveal flash) + apply stored theme (avoids theme
         flash). Storage is guarded; defaults mirror src/config/themes.ts. -->
    <script is:inline>
      (() => {
        const el = document.documentElement;
        el.classList.add('js');
        // Keep DESIGNS + defaults in sync with src/config/themes.ts.
        const DESIGNS = ['aurora', 'console', 'world'];
        let design = 'aurora';
        let mode = 'light';
        try {
          const sd = localStorage.getItem('taranity-design');
          const sm = localStorage.getItem('taranity-mode');
          if (DESIGNS.indexOf(sd) !== -1) design = sd;
          if (sm === 'light' || sm === 'dark') mode = sm;
        } catch {
          /* localStorage blocked (private mode / lockdown) — fall back to defaults */
        }
        el.setAttribute('data-design', design);
        el.setAttribute('data-mode', mode);
        const colors = {
          'aurora:light': '#f6f4ff',
          'aurora:dark': '#0a0613',
          'console:dark': '#070709',
          'console:light': '#eef1f7',
          'world:dark': '#05050f',
          'world:light': '#eef1ff',
        };
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', colors[design + ':' + mode] || '#f6f4ff');
      })();
    </script>

    <!-- Cookieless analytics (only when configured) -->
    {
      services.plausibleDomain && (
        <script
          is:inline
          defer
          data-domain={services.plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      )
    }

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Chrome />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../lib/motion';
      import { initCursor, initHudClock } from '../lib/cursor';
      import { initCommandPalette } from '../lib/commandPalette';
      import { initTheme } from '../lib/theme';
      import { initAuroraGL } from '../lib/aurora-gl';
      import { initWorldGL } from '../lib/world-gl';
      initTheme();
      initAuroraGL();
      initWorldGL();
      initCursor();
      initHudClock();
      initCommandPalette();
    </script>
  </body>
</html>
