---
/**
 * Layout for the design-showcase pages. Head, SEO, JSON-LD, the pre-paint
 * theme script, and the floating DesignSwitcher; everything visual belongs to
 * the design rendered into the slot (each design ships its own header/footer).
 *
 * Light or dark follows the visitor's system setting until they choose with
 * the toggle (src/lib/design-theme.ts). The inline script below must stay
 * CONSTANT across pages: it reads the per-design theme colours from data
 * attributes on <html>, so every design shares one CSP hash
 * (regenerate with scripts/csp-hash.mjs if it ever changes).
 */
import '../styles/site.css';
import { ClientRouter } from 'astro:transitions';
import DesignSwitcher from '../components/DesignSwitcher.astro';
import { site, services, socials, contactEmail } from '../config/site';
import { organizationLd, websiteLd, toGraph } from '../lib/structured-data';

interface Props {
  /** Design id from src/config/designs.ts; sets data-design on <html>. */
  design: string;
  /**
   * Clean canonical path for this content (defaults to the request path). Design VARIANT
   * pages (served at a canonical URL by the edge middleware) pass the clean canonical path
   * so the <link rel=canonical>, og:url, and the switcher's no-JS links all point at the
   * one canonical URL rather than the internal /<design>/... build path.
   */
  canonicalPath?: string;
  title: string;
  description: string;
  /** theme-color per mode; the pre-paint script and mode toggle read these. */
  themeLight: string;
  themeDark: string;
  /** OG image path relative to site root. */
  image?: string;
  /** og:type for the page; defaults to "website", journal articles pass "article". */
  ogType?: string;
  noindex?: boolean;
  /** Extra JSON-LD injected for this page (object or array of objects). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** LCP-critical font files to preload. */
  preloadFonts?: string[];
  /**
   * The design runs a smooth-scroll runtime (Lenis). The pre-paint script then
   * hides the native scrollbar (html.v-lenis) BEFORE first paint for visitors
   * without reduced motion, so the page never reflows by the scrollbar width
   * when the runtime boots; the design's motion module owns the class after
   * that (and removes it when Lenis is not driving).
   */
  smooth?: boolean;
}

const {
  design,
  canonicalPath = Astro.url.pathname,
  title,
  description,
  themeLight,
  themeDark,
  image = '/og.png',
  ogType = 'website',
  noindex = false,
  jsonLd,
  preloadFonts = ['/fonts/inter-latin-var.woff2'],
  smooth = false,
} = Astro.props;

const canonical = new URL(canonicalPath, site.url);
const ogImage = new URL(image, site.url);
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;

// One connected @graph for the page: the sitewide Organization and WebSite
// entities, plus any page-specific nodes (Article, BreadcrumbList, FAQPage)
// passed via the jsonLd prop. Emitting a single graph (rather than separate
// <script> blocks) guarantees the @id links between them resolve, instead of
// relying on each engine to merge same-@id nodes across blocks. Shapes live in
// src/lib/structured-data.ts so they can be unit-tested.
const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const graphLd = toGraph([
  organizationLd({
    name: site.name,
    url: site.url,
    description: site.description,
    shortTagline: site.shortTagline,
    founder: site.founder,
    contactEmail,
    socials,
  }),
  websiteLd({ name: site.name, url: site.url }),
  ...pageLd,
]);
---

<!doctype html>
<html
  lang="en"
  data-design={design}
  data-theme-light={themeLight}
  data-theme-dark={themeDark}
  data-smooth={smooth ? '' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeLight} />

    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <!-- Open Graph. og/twitter titles use the clean page title (no " · Taranity"
         suffix) so social cards and Medium imports come in clean; the brand is
         still carried by og:site_name, and <title> above keeps the suffix for SEO. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons + PWA manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Journal`} href="/rss.xml" />

    <!-- Structured data: one connected @graph (Organization, WebSite, and any page nodes) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graphLd).replace(/</g, '\\u003c')} />

    <!-- Pre-paint: mark JS available (motion gates on it) + resolve the mode
         (stored choice, else system) + sync theme-color, all before first paint
         so there is no flash. Keep this byte-identical across pages: the CSP
         allows exactly this script by hash. -->
    <script is:inline>
      (() => {
        const el = document.documentElement;
        el.classList.add('js');
        let mode = null;
        try {
          const stored = localStorage.getItem('taranity-mode');
          if (stored === 'light' || stored === 'dark') mode = stored;
        } catch {
          /* storage blocked (private mode / lockdown): follow the system */
        }
        if (!mode) mode = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        el.setAttribute('data-mode', mode);
        const color = el.getAttribute('data-theme-' + mode);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta && color) meta.setAttribute('content', color);
        if (el.hasAttribute('data-smooth') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          el.classList.add('v-lenis');
        }
      })();
    </script>

    <!-- Cookieless analytics: load at most ONE provider so two trackers never run
         at once. Cloudflare Web Analytics (the configured default) takes precedence;
         Plausible is the fallback if only it is set. If you switch the active
         provider, update the privacy page disclosure to match. -->
    {
      services.cfBeaconToken ? (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: services.cfBeaconToken })}
        />
      ) : services.plausibleDomain ? (
        <script
          is:inline
          defer
          data-domain={services.plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      ) : null
    }

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main">
      <slot />
    </main>
    <DesignSwitcher design={design} canonicalPath={canonicalPath} />

    <script>
      import { initDesignTheme } from '../lib/design-theme';
      initDesignTheme();
    </script>
  </body>
</html>
