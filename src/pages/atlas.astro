---
/**
 * Atlas (immersive dark 3D journey), the second design-showcase experience.
 * The flagship (Vitrine) renders at "/"; the floating switcher links between
 * them (src/config/designs.ts).
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Atlas from '../components/designs/atlas/Atlas.astro';
---

<SiteLayout
  design="atlas"
  canonicalPath="/"
  noindex
  title="Taranity · Atlas"
  description="Taranity is a digital studio working with clients worldwide. Atlas is the immersive face of the same studio: websites, stores, apps, automation, and intelligent systems, built for teams about to launch."
  themeLight="#05070d"
  themeDark="#05070d"
  preloadFonts={[
    '/fonts/space-grotesk-latin-var.woff2',
    '/fonts/inter-latin-var.woff2',
    '/fonts/jetbrains-mono-latin-400.woff2',
  ]}
  smooth
>
  <Atlas />
</SiteLayout>
