---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetricTile from '../../components/MetricTile.astro';
import Icon from '../../components/Icon.astro';
import { orderedProjects } from '../../content/projects';
import type { Project } from '../../content/projects';
import { site } from '../../config/site';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  orderedProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));

interface Props {
  project: Project;
}

const { project } = Astro.props;
const idx = orderedProjects.findIndex((p) => p.slug === project.slug);
const prev = orderedProjects[(idx - 1 + orderedProjects.length) % orderedProjects.length];
const next = orderedProjects[(idx + 1) % orderedProjects.length];

const projectLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  headline: project.tagline,
  abstract: project.summary,
  about: project.tags,
  url: `${site.url}/projects/${project.slug}`,
  creator: { '@type': 'Person', name: site.person },
  dateCreated: project.year,
};
---

<BaseLayout
  title={`${project.title} — ${project.tagline}`}
  description={project.summary}
  type="article"
  jsonLd={projectLd}
>
  <article class="cs">
    <a href="/work" class="cs-back" data-cursor="hover">
      <Icon name="arrow-left" size={16} /> all work
    </a>

    <!-- Header -->
    <header class="cs-head">
      <p class="cs-meta-top mono-label">
        {String(idx + 1).padStart(2, '0')} / {project.category} · {project.year}
      </p>
      <h1 class="cs-title" transition:name={`project-title-${project.slug}`}>
        {project.title}
      </h1>
      <span class="cs-rule" transition:name={`project-rule-${project.slug}`}></span>
      <p class="cs-tagline">{project.tagline}</p>

      <dl class="cs-facts">
        <div><dt class="mono-label">Role</dt><dd>{project.role}</dd></div>
        <div><dt class="mono-label">Timeline</dt><dd>{project.timeline}</dd></div>
        <div class="cs-facts-stack">
          <dt class="mono-label">Stack</dt>
          <dd class="cs-chips">
            {project.stack.map((s) => <span class="chip">{s}</span>)}
          </dd>
        </div>
      </dl>
    </header>

    <!-- Metric tiles -->
    <section class="cs-metrics" aria-label="Outcomes">
      {project.metrics.map((m) => <MetricTile value={m.value} label={m.label} />)}
    </section>

    <!-- Problem -> Solution -> Result -->
    <div class="cs-body">
      <section class="cs-block" data-reveal>
        <p class="cs-block-label mono-label"><span class="cs-num">01</span> Problem</p>
        <div class="cs-prose">
          {project.problem.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <section class="cs-block" data-reveal>
        <p class="cs-block-label mono-label"><span class="cs-num">02</span> Solution</p>
        <div class="cs-prose">
          {project.solution.map((p) => <p>{p}</p>)}
          <ul class="cs-highlights">
            {
              project.highlights.map((h) => (
                <li>
                  <Icon name="arrow-right" size={15} class="cs-hl-icon" />
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="cs-block" data-reveal>
        <p class="cs-block-label mono-label"><span class="cs-num">03</span> Result</p>
        <div class="cs-prose">
          {project.result.map((p) => <p>{p}</p>)}
        </div>
        <div class="cs-result-metrics">
          {project.metrics.map((m) => (
            <div class="cs-rm">
              <span class="cs-rm-value gradient-text">{m.value}</span>
              <span class="cs-rm-label">{m.label}</span>
            </div>
          ))}
        </div>
      </section>
    </div>

    {
      project.links && project.links.length > 0 && (
        <section class="cs-links">
          {project.links.map((l) => (
            <a href={l.href} class="btn btn-ghost" target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined} data-cursor="hover">
              {l.label} <Icon name={l.external ? 'arrow-up-right' : 'arrow-right'} size={15} class="arrow" />
            </a>
          ))}
        </section>
      )
    }

    <!-- Prev / Next -->
    <nav class="cs-nav" aria-label="More projects">
      <a href={`/projects/${prev.slug}`} class="cs-nav-item" data-cursor="hover">
        <span class="mono-label"><Icon name="arrow-left" size={14} /> previous</span>
        <span class="cs-nav-title">{prev.title}</span>
      </a>
      <a href={`/projects/${next.slug}`} class="cs-nav-item cs-nav-next" data-cursor="hover">
        <span class="mono-label">next <Icon name="arrow-right" size={14} /></span>
        <span class="cs-nav-title">{next.title}</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .cs {
    max-width: 880px;
    margin: 0 auto;
    padding: 7rem var(--spacing-gutter) 0;
    position: relative;
    z-index: 1;
  }
  .cs-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-dim);
    margin-bottom: 2.5rem;
  }
  .cs-back:hover { color: var(--color-cyan); }

  .cs-meta-top { color: var(--color-cyan); margin-bottom: 1rem; }
  .cs-title { font-size: var(--text-display); line-height: 0.95; }
  .cs-rule {
    display: block;
    height: 3px;
    width: 80px;
    background: var(--grad-holo);
    margin: 1.5rem 0;
    border-radius: 2px;
  }
  .cs-tagline {
    font-size: var(--text-lead);
    color: var(--color-ink);
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }

  .cs-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    margin: 0 0 3rem;
  }
  .cs-facts dt { margin-bottom: 0.5rem; }
  .cs-facts dd { margin: 0; font-size: 0.98rem; color: var(--color-ink); }
  .cs-facts-stack { flex: 1 1 100%; }
  .cs-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .cs-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .cs-body { display: grid; gap: 3.5rem; }
  .cs-block-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-ink);
    font-size: 0.85rem;
    margin-bottom: 1.3rem;
    letter-spacing: 0.12em;
  }
  .cs-num { color: var(--color-cyan); }
  .cs-prose p {
    font-size: var(--text-lead);
    line-height: 1.7;
    color: var(--color-ink-dim);
    margin-bottom: 1.1rem;
    max-width: 64ch;
  }
  .cs-highlights {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .cs-highlights li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: var(--color-ink);
    font-size: 1rem;
    line-height: 1.5;
  }
  .cs-hl-icon { color: var(--color-cyan); flex: 0 0 auto; margin-top: 0.2rem; }

  .cs-result-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }
  .cs-rm { display: flex; flex-direction: column; gap: 0.2rem; }
  .cs-rm-value { font-family: var(--font-mono); font-weight: 700; font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1; }
  .cs-rm-label { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink-faint); }

  .cs-links { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 3rem; }

  .cs-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }
  .cs-nav-item { display: flex; flex-direction: column; gap: 0.4rem; }
  .cs-nav-item .mono-label { display: inline-flex; align-items: center; gap: 0.3rem; }
  .cs-nav-next { text-align: right; align-items: flex-end; }
  .cs-nav-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-h3); color: var(--color-ink); }
  .cs-nav-item:hover .cs-nav-title { color: var(--color-cyan); }

  @media (max-width: 620px) {
    .cs-metrics { grid-template-columns: 1fr; }
    .cs-facts { gap: 1.5rem; }
    .cs-title { font-size: var(--text-h1); }
  }
</style>
