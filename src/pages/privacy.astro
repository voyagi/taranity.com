---
import SiteLayout from '../layouts/SiteLayout.astro';
import VitrinePage from '../components/designs/vitrine/VitrinePage.astro';
import PrivacyContent from '../components/PrivacyContent.astro';
---

<SiteLayout
  design="vitrine"
  title="Privacy"
  description="What taranity.com collects, how it is handled, and your rights, in plain language."
  themeLight="#f4f0e8"
  themeDark="#110f0c"
  preloadFonts={['/fonts/fraunces-latin-var.woff2', '/fonts/inter-latin-var.woff2']}
>
  <VitrinePage>
    <section class="v-page" tabindex="-1">
      <PrivacyContent />
    </section>
  </VitrinePage>
</SiteLayout>
