---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { orderedProjects } from '../content/projects';
import { site } from '../config/site';

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Selected work — Taranity',
  itemListElement: orderedProjects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site.url}/projects/${p.slug}`,
    name: p.title,
  })),
};
---

<BaseLayout
  title="Work — case studies across AI, apps & web"
  description="Selected work by Taranity: AI systems, apps, websites, and workflow automation — each framed problem, solution, and measurable result."
  jsonLd={itemListLd}
>
  <!-- Intro -->
  <section class="work-intro">
    <p class="band-label mono-label" data-reveal>/ the work · {orderedProjects.length} projects</p>
    <h1 class="work-title" data-reveal>Things we built that<br /><span class="gradient-text">moved a number.</span></h1>
    <p class="work-lead" data-reveal>
      Every project here is framed the same way — the problem, what we built, and the result you
      can measure. <span class="work-hint">Scroll through, or open any one for the full case study.</span>
    </p>
  </section>

  <!-- Gallery: horizontal pinned (desktop) / vertical stack (mobile, reduced-motion) -->
  <section class="gallery-pin" data-gallery-pin aria-label="Project gallery">
    <h2 class="sr-only">Project case studies</h2>
    <ol class="gallery" data-gallery>
      {
        orderedProjects.map((p, i) => (
          <li data-panel>
            <ProjectCard project={p} index={String(i + 1).padStart(2, '0')} variant="panel" />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Closing -->
  <section class="work-outro">
    <p data-reveal>
      Want the same for what you're building?
      <a href="/contact" class="work-outro-link" data-cursor="hover">
        Start a project <Icon name="arrow-right" size={16} class="arrow" />
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .work-intro {
    max-width: 1240px;
    margin: 0 auto;
    padding: 8rem var(--spacing-gutter) 3rem;
    position: relative;
    z-index: 1;
  }
  .band-label { color: var(--color-cyan); margin-bottom: 1rem; }
  .work-title {
    font-size: var(--text-h1);
    line-height: 1.02;
    margin-bottom: 1.4rem;
  }
  .work-lead {
    color: var(--color-ink-dim);
    font-size: var(--text-lead);
    line-height: 1.6;
    max-width: 56ch;
  }
  .work-hint { color: var(--color-ink-faint); }

  .gallery-pin {
    position: relative;
    z-index: 1;
  }
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0 var(--spacing-gutter);
    display: grid;
    gap: 1.2rem;
    max-width: 1240px;
    margin: 0 auto;
  }
  .gallery > li { display: block; }

  /* Desktop: horizontal track (native scroll fallback before/without JS) */
  @media (min-width: 1024px) {
    .gallery-pin { overflow-x: auto; scrollbar-width: none; }
    .gallery-pin::-webkit-scrollbar { display: none; }
    .gallery {
      display: flex;
      flex-wrap: nowrap;
      width: max-content;
      max-width: none;
      gap: 2rem;
      padding: 2rem max(var(--spacing-gutter), calc((100vw - 1240px) / 2 + var(--spacing-gutter)));
    }
    .gallery > li { width: min(62vw, 660px); flex: 0 0 auto; }

    /* JS-activated pinned mode */
    .gallery-pin:has(.is-horizontal) {
      overflow: hidden;
      height: 100vh;
      display: flex;
      align-items: center;
    }
  }

  .work-outro {
    max-width: 1240px;
    margin: 0 auto;
    padding: var(--spacing-section) var(--spacing-gutter);
    position: relative;
    z-index: 1;
  }
  .work-outro p {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-ink-dim);
  }
  .work-outro-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-cyan);
    margin-left: 0.4rem;
  }

  /* Compact panels on small screens */
  @media (max-width: 1023px) {
    :global(.pcard.is-panel) { min-height: 300px; }
  }
</style>
