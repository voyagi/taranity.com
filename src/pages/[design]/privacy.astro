---
/**
 * Per-design privacy pages: /signal/privacy, /atlas/privacy, etc. Each renders
 * the shared PrivacyContent inside its design's subpage shell, so a visitor who
 * clicks Privacy from a design stays in that design's look. Vitrine keeps the
 * canonical /privacy (src/pages/privacy.astro), so it is excluded here; these
 * variants are noindex to avoid duplicate content.
 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import PrivacyContent from '../../components/PrivacyContent.astro';
import AtlasSubpage from '../../components/designs/atlas/AtlasSubpage.astro';
import SignalSubpage from '../../components/designs/signal/SignalSubpage.astro';
import StorefrontSubpage from '../../components/designs/storefront/StorefrontSubpage.astro';
import PracticeSubpage from '../../components/designs/practice/PracticeSubpage.astro';
import RawSubpage from '../../components/designs/raw/RawSubpage.astro';
import SheetSubpage from '../../components/designs/sheet/SheetSubpage.astro';
import PrismSubpage from '../../components/designs/prism/PrismSubpage.astro';
import { readyDesigns, getDesign } from '../../config/designs';
import { subpageMeta } from '../../config/subpage-meta';
import { privacyContent } from '../../config/subpages';

// Map each non-Vitrine design to its subpage shell. `satisfies` ties this to the keys of
// subpageMeta (theme-colour + LCP fonts), so adding a design to one without the other is a
// compile-time error. The journal variant routes use the same subpageMeta source.
const SHELLS = {
  atlas: AtlasSubpage,
  signal: SignalSubpage,
  storefront: StorefrontSubpage,
  practice: PracticeSubpage,
  raw: RawSubpage,
  sheet: SheetSubpage,
  prism: PrismSubpage,
} satisfies Record<keyof typeof subpageMeta, unknown>;

export function getStaticPaths() {
  // Vitrine keeps the canonical /privacy, so it is excluded. A non-Vitrine ready design
  // with no SHELLS/subpageMeta entry fails the build loudly via the guard below.
  return readyDesigns()
    .filter((d) => d.id !== 'vitrine')
    .map((d) => ({ params: { design: d.id } }));
}

const design = Astro.params.design as keyof typeof subpageMeta;
const d = getDesign(design);
const meta = subpageMeta[design];
const Shell = SHELLS[design];
if (!d || !meta || !Shell) throw new Error(`No privacy subpage shell/meta for design "${design}"`);
---

<SiteLayout
  design={design}
  canonicalPath="/privacy"
  title={privacyContent.metaTitle}
  description={privacyContent.metaDescription}
  themeLight={meta.themeLight}
  themeDark={meta.themeDark}
  preloadFonts={meta.fonts}
  noindex
>
  <Shell>
    <PrivacyContent />
  </Shell>
</SiteLayout>
