---
import SiteLayout from '../layouts/SiteLayout.astro';
import VitrinePage from '../components/designs/vitrine/VitrinePage.astro';
---

<SiteLayout
  design="vitrine"
  title="404"
  description="This route was not found."
  themeLight="#f4f0e8"
  themeDark="#110f0c"
  preloadFonts={['/fonts/fraunces-latin-var.woff2', '/fonts/inter-latin-var.woff2']}
  noindex
>
  <VitrinePage>
    <section class="v-page v-nf" tabindex="-1">
      <p class="v-label">404</p>
      <h1 class="v-page-title v-serif">This route was not found.</h1>
      <p class="v-page-lead">
        The page you are after does not exist or has moved. The studio, the
        crafts, and the contact form are all one page away.
      </p>
      <a class="v-nf-back" href="/">Back to the studio</a>
    </section>
  </VitrinePage>
</SiteLayout>

<style>
  .v-nf {
    min-height: 72svh;
  }
  .v-nf-back {
    font-family: var(--v-serif);
    font-optical-sizing: auto;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    font-weight: 420;
  }
</style>
