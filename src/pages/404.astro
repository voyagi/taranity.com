---
// Copy comes from src/data/not-found.json (editable at /admin).
import SiteLayout from '../layouts/SiteLayout.astro';
import VitrinePage from '../components/designs/vitrine/VitrinePage.astro';
import { notFoundContent } from '../config/subpages';
---

<SiteLayout
  design="vitrine"
  title={notFoundContent.metaTitle}
  description={notFoundContent.metaDescription}
  themeLight="#f4f0e8"
  themeDark="#110f0c"
  preloadFonts={['/fonts/fraunces-latin-var.woff2', '/fonts/inter-latin-var.woff2']}
  noindex
>
  <VitrinePage>
    <section class="v-page v-nf" tabindex="-1">
      <p class="v-label">{notFoundContent.label}</p>
      <h1 class="v-page-title v-serif">{notFoundContent.heading}</h1>
      <p class="v-page-lead">{notFoundContent.lead}</p>
      <a class="v-nf-back" href="/">{notFoundContent.backLabel}</a>
    </section>
  </VitrinePage>
</SiteLayout>

<style>
  .v-nf {
    min-height: 72svh;
  }
  .v-nf-back {
    font-family: var(--v-serif);
    font-optical-sizing: auto;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    font-weight: 420;
  }
</style>
