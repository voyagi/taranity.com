---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Taranity" description="Get in touch for collaborations and opportunities.">
  <main class="py-(--spacing-section) px-6 max-w-4xl mx-auto">
    <h1 class="font-display text-5xl font-bold mb-6">Let's work together</h1>
    <p class="text-text-secondary text-lg mb-12">
      Currently available for freelance work and collaborations.
    </p>

    <!-- Contact form placeholder -->
    <div class="glass rounded-2xl p-8 max-w-lg">
      <p class="text-text-secondary">
        Placeholder — Web3Forms contact form coming after visual direction.
      </p>
    </div>
  </main>
</BaseLayout>
