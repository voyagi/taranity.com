---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, socials, contactEmail, cta, site } from '../config/site';

const hasKey = Boolean(services.web3formsKey);
const bookingExternal = /^https?:\/\//.test(cta.primaryHref);
const iconFor: Record<string, 'github' | 'linkedin' | 'x'> = {
  GitHub: 'github',
  LinkedIn: 'linkedin',
  'X / Twitter': 'x',
};
---

<BaseLayout
  title="Contact — let's automate what's slowing you down"
  description="Start a project or book a call with Taran — full-stack developer and automation architect."
>
  <section class="contact">
    <div class="contact-grid">
      <!-- Left: invitation + channels -->
      <div class="contact-aside">
        <p class="band-label mono-label" data-reveal>/ contact</p>
        <h1 class="contact-title" data-reveal>Let's automate what's<br /><span class="gradient-text">slowing you down.</span></h1>
        <p class="contact-lead" data-reveal>
          Tell me what's eating your time. I reply to everything — usually within a day. If it's a
          fit, the next step is a short call.
        </p>

        <div class="contact-channels" data-reveal>
          <a href={cta.primaryHref} class="channel channel-primary glass holo-edge" data-cursor="hover" target={bookingExternal ? '_blank' : undefined} rel={bookingExternal ? 'noopener noreferrer' : undefined}>
            <Icon name="calendar" size={20} />
            <span>
              <strong>Book a call</strong>
              <span class="channel-sub">{bookingExternal ? '15-min intro' : 'pick a time'}</span>
            </span>
            <Icon name="arrow-up-right" size={16} class="channel-arrow" />
          </a>
          <a href={`mailto:${contactEmail}`} class="channel glass" data-cursor="hover">
            <Icon name="mail" size={20} />
            <span><strong>{contactEmail}</strong><span class="channel-sub">email me directly</span></span>
          </a>
        </div>

        <div class="contact-meta" data-reveal>
          <p class="mono-label"><span class="avail-dot"></span> available for new work · {site.location}</p>
          <ul class="contact-socials">
            {
              socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} data-cursor="hover">
                    <Icon name={iconFor[s.label] ?? 'arrow-up-right'} size={18} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Right: form -->
      <div class="contact-form-wrap glass-strong holo-edge" data-reveal data-reveal-delay="120">
        <form
          class="contact-form"
          data-contact-form
          data-fallback-email={contactEmail}
          action="https://api.web3forms.com/submit"
          method="POST"
          novalidate
        >
          <input type="hidden" name="access_key" value={services.web3formsKey} />
          <input type="hidden" name="subject" value="New project enquiry via taranity.com" />
          <input type="hidden" name="from_name" value="taranity.com" />
          <!-- Honeypot -->
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

          {!hasKey && (
            <p class="demo-note mono-label">
              demo mode — add a Web3Forms key to send for real (see HUMAN-TODO)
            </p>
          )}

          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name" aria-describedby="err-name" />
            <span class="field-err" id="err-name" data-err="name" role="alert"></span>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" aria-describedby="err-email" />
            <span class="field-err" id="err-email" data-err="email" role="alert"></span>
          </div>

          <div class="field">
            <label for="project">What do you need built? <span class="opt">(optional)</span></label>
            <select id="project" name="project_type">
              <option value="">Pick one…</option>
              <option>Workflow / process automation</option>
              <option>AI tooling, agent, or MCP server</option>
              <option>Full-stack product / SaaS</option>
              <option>Something else</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required aria-describedby="err-message"></textarea>
            <span class="field-err" id="err-message" data-err="message" role="alert"></span>
          </div>

          <button type="submit" class="btn btn-primary contact-submit" data-cursor="hover">
            <span data-submit-label>Send message</span>
            <Icon name="arrow-right" size={16} class="arrow" />
          </button>

          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
          <p class="form-privacy mono-label">
            Your details are used only to reply. No newsletter, no third parties, no cookies.
          </p>
        </form>

        <!-- Success panel (revealed on submit) -->
        <div class="form-success" data-form-success hidden>
          <span class="success-mark"><Icon name="terminal" size={22} /></span>
          <p class="success-code mono-label">200 · message transmitted</p>
          <h2>Got it — thank you.</h2>
          <p>I read everything personally and reply within a day, usually sooner. If it's a fit, I'll suggest a time to talk.</p>
          <a href="/work" class="btn btn-ghost" data-cursor="hover">Meanwhile, see the work <Icon name="arrow-right" size={15} class="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    max-width: 1180px;
    margin: 0 auto;
    padding: 8rem var(--spacing-gutter) var(--spacing-section);
    position: relative;
    z-index: 1;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .band-label { color: var(--color-cyan); margin-bottom: 1rem; }
  .contact-title { font-size: var(--text-h1); line-height: 1.02; margin-bottom: 1.4rem; }
  .contact-lead { color: var(--color-ink-dim); font-size: var(--text-lead); line-height: 1.6; max-width: 44ch; margin-bottom: 2.5rem; }

  .contact-channels { display: grid; gap: 0.8rem; margin-bottom: 2.5rem; }
  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    color: var(--color-ink);
    transition: transform 0.3s var(--ease-out-expo);
  }
  .channel:hover { transform: translateY(-2px); }
  .channel strong { display: block; font-size: 1rem; }
  .channel-sub { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-ink-faint); }
  .channel-arrow { margin-left: auto; color: var(--color-cyan); }
  .channel-primary { border-color: var(--color-line-strong); }
  .channel > :global(svg:first-child) { color: var(--color-cyan); flex: 0 0 auto; }

  .contact-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .avail-dot {
    display: inline-block;
    width: 7px; height: 7px; border-radius: 999px;
    background: var(--color-success);
    box-shadow: 0 0 8px 1px rgba(52, 211, 153, 0.8);
    margin-right: 0.3rem;
  }
  .contact-socials { display: flex; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .contact-socials a {
    display: grid; place-items: center; width: 40px; height: 40px;
    border-radius: 999px; border: 1px solid var(--color-line); color: var(--color-ink-dim);
    transition: color 0.2s, border-color 0.2s;
  }
  .contact-socials a:hover { color: var(--color-cyan); border-color: var(--color-line-strong); }

  /* Form */
  .contact-form-wrap { padding: clamp(1.6rem, 4vw, 2.5rem); position: relative; }
  .hp { position: absolute; left: -9999px; opacity: 0; }
  .demo-note {
    color: var(--color-cyan);
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    padding: 0.6rem 0.8rem;
    margin-bottom: 1.4rem;
  }
  .field { margin-bottom: 1.3rem; }
  .field label { display: block; font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-ink-dim); margin-bottom: 0.5rem; }
  .field .opt { text-transform: none; letter-spacing: 0; color: var(--color-ink-faint); }
  .field input, .field textarea, .field select {
    width: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-line);
    border-radius: 0.7rem;
    padding: 0.85rem 1rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field textarea { resize: vertical; min-height: 120px; }
  .field select { font-family: var(--font-mono); font-size: 0.9rem; }
  .field input:focus, .field textarea:focus, .field select:focus {
    outline: none;
    border-color: var(--color-cyan);
    box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.15);
  }
  .field.invalid input, .field.invalid textarea { border-color: var(--color-danger); }
  .field-err { display: block; min-height: 1rem; margin-top: 0.4rem; font-size: 0.78rem; color: var(--color-danger); font-family: var(--font-mono); }
  .contact-submit { width: 100%; justify-content: center; margin-top: 0.4rem; }
  .contact-submit[disabled] { opacity: 0.6; cursor: progress; }
  .form-status { margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.82rem; min-height: 1rem; }
  .form-status.is-error { color: var(--color-danger); }
  .form-privacy { margin-top: 1.2rem; color: var(--color-ink-faint); line-height: 1.5; }

  .form-success { text-align: center; padding: 1rem; }
  .form-success[hidden] { display: none; }
  .success-mark {
    display: inline-grid; place-items: center;
    width: 54px; height: 54px; border-radius: 999px;
    color: var(--color-success);
    border: 1px solid rgba(52, 211, 153, 0.4);
    box-shadow: 0 0 24px -6px rgba(52, 211, 153, 0.5);
    margin-bottom: 1.2rem;
  }
  .success-code { color: var(--color-success); margin-bottom: 0.6rem; }
  .form-success h2 { font-size: var(--text-h3); margin-bottom: 0.7rem; }
  .form-success p { color: var(--color-ink-dim); line-height: 1.6; max-width: 40ch; margin: 0 auto 1.6rem; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-title { font-size: clamp(2.2rem, 9vw, 3rem); }
  }
</style>

<script>
  const KEY = (import.meta.env.PUBLIC_WEB3FORMS_KEY as string) || '';

  function bindContact() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';

    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('.contact-submit')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const successPanel = document
      .querySelector<HTMLElement>('[data-form-success]')!;

    const setErr = (name: string, msg: string) => {
      const field = form.querySelector(`[name="${name}"]`)?.closest('.field');
      const errEl = form.querySelector(`[data-err="${name}"]`);
      if (field) field.classList.toggle('invalid', Boolean(msg));
      if (errEl) errEl.textContent = msg;
    };

    const validate = () => {
      let ok = true;
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const message = String(data.get('message') || '').trim();

      setErr('name', name ? '' : 'Tell me your name.');
      if (!name) ok = false;

      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      setErr('email', email ? (emailOk ? '' : 'That email looks off.') : 'I need an email to reply.');
      if (!emailOk) ok = false;

      setErr('message', message.length >= 10 ? '' : 'A sentence or two, please (10+ chars).');
      if (message.length < 10) ok = false;

      if (!ok) {
        const firstInvalid = form.querySelector<HTMLElement>('.field.invalid input, .field.invalid textarea');
        firstInvalid?.focus();
      }
      return ok;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.classList.remove('is-error');
      if (!validate()) return;

      // Honeypot
      if ((form.querySelector('[name="botcheck"]') as HTMLInputElement)?.checked) return;

      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending…';

      const showSuccess = () => {
        form.hidden = true;
        successPanel.hidden = false;
        successPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      // Demo mode: no key → simulate success so the flow is reviewable.
      if (!KEY) {
        await new Promise((r) => setTimeout(r, 700));
        showSuccess();
        return;
      }

      try {
        // Hardcoded endpoint — never trust a DOM attribute for the POST target.
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          showSuccess();
        } else {
          throw new Error(json.message || 'Send failed');
        }
      } catch (err) {
        const fallbackEmail = form.dataset.fallbackEmail || 'hello@taranity.com';
        status.textContent = `Couldn't send. Email ${fallbackEmail} directly?`;
        status.classList.add('is-error');
        submitBtn.disabled = false;
        submitLabel.textContent = 'Try again';
      }
    });

    // Clear error as the user fixes a field
    form.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('input', () => {
        const name = (el as HTMLInputElement).name;
        if (el.closest('.field')?.classList.contains('invalid')) setErr(name, '');
      });
    });
  }

  document.addEventListener('astro:page-load', bindContact);
</script>
