---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { story, principles, skillGroups, timeline, languages } from '../config/about';
import { cta } from '../config/site';

const [lead, ...rest] = story;
---

<BaseLayout
  title="About — the studio behind the work"
  description="How Taranity grew from automating a university timetable into a studio building AI systems, apps, and websites across the whole digital stack."
>
  <section class="about-hero">
    <p class="band-label mono-label" data-reveal>/ about</p>
    <h1 class="about-title" data-reveal>
      We build across the whole <span class="gradient-text">digital stack.</span>
    </h1>
    <p class="about-lead" data-reveal>{lead}</p>
  </section>

  <section class="band about-story">
    {rest.map((p) => <p data-reveal>{p}</p>)}
  </section>

  <!-- Principles -->
  <section class="band">
    <h2 class="sr-only">How we work</h2>
    <p class="band-label mono-label" data-reveal>/ how we work</p>
    <div class="principles">
      {
        principles.map((p, i) => (
          <article class="principle glass holo-edge" data-reveal data-reveal-delay={i * 70}>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Skills -->
  <section class="band">
    <p class="band-label mono-label" data-reveal>/ the toolkit</p>
    <h2 class="section-title" data-reveal>What we reach for</h2>
    <div class="skills">
      {
        skillGroups.map((group) => (
          <div class="skill-group">
            <p class="skill-group-label mono-label" data-reveal>{group.label}</p>
            <ul>
              {group.skills.map((s) => (
                <li class="skill-row" data-reveal>
                  <span class="skill-name">{s.name}</span>
                  <span class="skill-bar"><span class="bar-fill" style={`--lvl:${s.level}%`} /></span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Timeline -->
  <section class="band">
    <p class="band-label mono-label" data-reveal>/ the path</p>
    <ol class="timeline">
      {
        timeline.map((t) => (
          <li class="tl-item" data-reveal>
            <span class="tl-node" aria-hidden="true" />
            <div class="tl-content">
              <span class="tl-when mono-label">{t.when}</span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Languages + CTA -->
  <section class="band about-foot">
    <div class="languages" data-reveal>
      <p class="band-label mono-label">/ languages</p>
      <ul>
        {
          languages.map((l) => (
            <li><span class="lang-name">{l.name}</span><span class="lang-level mono-label">{l.level}</span></li>
          ))
        }
      </ul>
    </div>
    <div class="about-cta glass-strong holo-edge" data-reveal>
      <h2>Have something hard to build?</h2>
      <a href={cta.primaryHref} class="btn btn-primary" data-cursor="hover">
        {cta.primaryLabel}<Icon name="arrow-right" size={16} class="arrow" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    max-width: 880px;
    margin: 0 auto;
    padding: 8rem var(--spacing-gutter) 2rem;
    position: relative;
    z-index: 1;
  }
  .band-label { color: var(--color-cyan); margin-bottom: 1rem; }
  .about-title { font-size: var(--text-display); line-height: 0.98; margin-bottom: 1.8rem; }
  .about-lead {
    font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem);
    line-height: 1.5;
    color: var(--color-ink);
    max-width: 54ch;
  }

  .band {
    max-width: 880px;
    margin: 0 auto;
    padding: var(--spacing-section) var(--spacing-gutter);
    position: relative;
    z-index: 1;
  }
  .section-title { font-size: var(--text-h2); margin-bottom: 2.5rem; }

  .about-story { padding-top: 2rem; }
  .about-story p {
    font-size: var(--text-lead);
    line-height: 1.75;
    color: var(--color-ink-dim);
    max-width: 64ch;
    margin-bottom: 1.4rem;
  }

  .principles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }
  .principle { padding: 1.8rem; }
  .principle h3 { font-size: var(--text-h3); margin-bottom: 0.7rem; }
  .principle p { color: var(--color-ink-dim); font-size: 0.96rem; line-height: 1.6; }

  .skills { display: grid; gap: 2.5rem; }
  .skill-group-label { color: var(--color-ink); margin-bottom: 1.2rem; letter-spacing: 0.16em; }
  .skill-group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .skill-row { display: grid; grid-template-columns: 1fr 40%; gap: 1.5rem; align-items: center; }
  .skill-name { font-size: 0.98rem; color: var(--color-ink); }
  .skill-bar {
    height: 6px;
    background: var(--glass-2);
    border-radius: 999px;
    overflow: hidden;
  }
  .bar-fill {
    display: block;
    height: 100%;
    width: var(--lvl);
    background: var(--grad-holo);
    border-radius: 999px;
  }
  .js .bar-fill { width: 0; transition: width 1.1s var(--ease-out-expo); }
  .js .skill-row.is-in .bar-fill { width: var(--lvl); }

  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .tl-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    padding-bottom: 2.5rem;
    position: relative;
  }
  .tl-item::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 14px;
    bottom: 0;
    width: 1px;
    background: var(--color-line);
  }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-item:last-child::before { display: none; }
  .tl-node {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--color-cyan);
    box-shadow: 0 0 10px 1px rgba(var(--accent-rgb), 0.7);
    margin-top: 5px;
    z-index: 1;
  }
  .tl-when { color: var(--color-cyan); display: block; margin-bottom: 0.4rem; }
  .tl-content h3 { font-size: var(--text-h3); margin-bottom: 0.5rem; }
  .tl-content p { color: var(--color-ink-dim); font-size: 0.98rem; line-height: 1.6; max-width: 58ch; }

  .about-foot {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2.5rem;
    align-items: center;
  }
  .languages ul { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.8rem; }
  .languages li { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--color-line); }
  .lang-name { color: var(--color-ink); }
  .lang-level { color: var(--color-ink-faint); }
  .about-cta { padding: 2.2rem; text-align: center; }
  .about-cta h2 { font-size: var(--text-h3); margin-bottom: 1.3rem; }

  @media (max-width: 680px) {
    .principles { grid-template-columns: 1fr; }
    .about-foot { grid-template-columns: 1fr; }
    .skill-row { grid-template-columns: 1fr; gap: 0.5rem; }
    .about-title { font-size: var(--text-h1); }
  }
</style>
