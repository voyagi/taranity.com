---
/**
 * Open Graph image source (1200×630), in the Vitrine design language.
 * Rendered with the real fonts, then screenshotted to public/og.png.
 * Disallowed in robots, excluded from sitemap. Regenerate: serve the build,
 * screenshot /og-preview at 1200×630 → public/og.png.
 */
import '../styles/fonts.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og</title>
  </head>
  <body class="og-body">
    <div class="og">
      <span class="og-star s1"></span>
      <span class="og-star s2"></span>
      <span class="og-star s3"></span>
      <span class="og-star s4"></span>
      <span class="og-star s5"></span>
      <span class="og-star s6"></span>
      <span class="og-star s7"></span>

      <header class="og-top">
        <span class="og-mark">Taranity</span>
        <span class="og-tag">Digital studio · Working worldwide</span>
      </header>

      <div class="og-main">
        <h1 class="og-h1">Made to be<br /><span class="og-em">remembered.</span></h1>
      </div>

      <footer class="og-foot">
        <span>Websites · Commerce · Applications · Automation · Advisory · Intelligent systems</span>
        <span class="og-url">taranity.com</span>
      </footer>
    </div>
  </body>
</html>

<style>
  .og-body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }
  .og {
    position: relative;
    box-sizing: border-box;
    width: 1200px;
    height: 630px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 56px 72px 48px;
    background:
      radial-gradient(46% 58% at 78% 18%, rgba(198, 160, 105, 0.12), transparent 72%),
      #110f0c;
    color: #ece5d8;
    border: 1px solid rgba(236, 229, 216, 0.18);
    outline: 1px solid rgba(236, 229, 216, 0.07);
    outline-offset: -12px;
  }
  .og-star {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: rgba(236, 229, 216, 0.8);
  }
  .s1 { top: 84px; left: 540px; }
  .s2 { top: 150px; left: 880px; opacity: 0.6; }
  .s3 { top: 70px; left: 1080px; }
  .s4 { top: 250px; left: 1130px; opacity: 0.5; }
  .s5 { top: 420px; left: 980px; opacity: 0.7; }
  .s6 { top: 330px; left: 700px; opacity: 0.45; }
  .s7 { top: 520px; left: 460px; opacity: 0.5; }

  .og-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .og-mark {
    font-family: 'Inter Variable', sans-serif;
    font-size: 21px;
    font-weight: 640;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }
  .og-tag {
    font-family: 'Inter Variable', sans-serif;
    font-size: 15px;
    font-weight: 560;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #c9a36a;
  }
  .og-h1 {
    margin: 0;
    font-family: 'Fraunces Variable', Georgia, serif;
    font-optical-sizing: auto;
    font-size: 124px;
    font-weight: 360;
    line-height: 0.95;
    letter-spacing: -0.015em;
  }
  .og-em {
    font-weight: 250;
  }
  .og-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid rgba(236, 229, 216, 0.18);
    padding-top: 22px;
    font-family: 'Inter Variable', sans-serif;
    font-size: 14.5px;
    font-weight: 540;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(236, 229, 216, 0.78);
  }
  .og-url {
    color: #c9a36a;
  }
</style>
