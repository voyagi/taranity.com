---
/**
 * Journal article: renders one collection entry in the Vitrine subpage shell.
 * SEO (title, description, canonical, OG) is handled by SiteLayout; this route
 * supplies the Article + BreadcrumbList + FAQPage structured data via the
 * layout's `jsonLd` prop. The visible FAQ and the FAQPage JSON-LD both read the
 * frontmatter `faqs`, so they cannot drift. Studio "we" voice, no byline.
 */
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import VitrinePage from '../../components/designs/vitrine/VitrinePage.astro';
import { site } from '../../config/site';
import { relatedPosts } from '../../lib/related-posts';
import { orgId as makeOrgId, websiteId as makeWebsiteId } from '../../lib/structured-data';
import '../../styles/journal.css';

export async function getStaticPaths() {
  const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  // Pass up to three other published articles for the "Keep reading" footer.
  // Internal links between articles help readers and crawlers find the rest of
  // the journal; the block self-populates as drip-scheduled drafts go live and
  // renders nothing while this is the only published piece. relatedPosts rotates
  // the window so each article surfaces a different set (see src/lib/related-posts.ts).
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(posts, index) },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, description, lead, kicker, pubDate, updatedDate, faqs, heroImage, keywords } = post.data;

// Slash-free canonical (matches <link rel=canonical>, the sitemap, and internal links).
const canonical = new URL(`/journal/${post.id}`, site.url).href;
// Same Organization @id the layout emits sitewide (one shared helper, so the
// Article's author/publisher references can never drift from the org node).
const orgId = makeOrgId(site.url);
const modified = updatedDate ?? pubDate;
const dateLabel = pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

// Approximate word count from the raw markdown body (a recognised Article depth
// signal for answer engines). Guarded so a missing body omits the field rather
// than emitting a misleading 0.
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: 'en',
  image: new URL(heroImage ?? '/og.png', site.url).href,
  author: { '@type': 'Organization', '@id': orgId, name: site.name, url: site.url },
  publisher: {
    '@type': 'Organization',
    '@id': orgId,
    name: site.name,
    url: site.url,
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', site.url).href },
  },
  url: canonical,
  mainEntityOfPage: canonical,
  // Section, the article's own keywords, and a link into the WebSite entity, so
  // the Article sits in the same connected @graph the layout emits.
  articleSection: kicker,
  isPartOf: { '@id': makeWebsiteId(site.url) },
  ...(keywords.length > 0 ? { keywords } : {}),
  ...(wordCount > 0 ? { wordCount } : {}),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Journal', item: new URL('/journal', site.url).href },
    { '@type': 'ListItem', position: 2, name: title, item: canonical },
  ],
};
const faqLd =
  faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const jsonLd = faqLd ? [articleLd, breadcrumbLd, faqLd] : [articleLd, breadcrumbLd];
---

<SiteLayout
  design="vitrine"
  canonicalPath={`/journal/${post.id}`}
  title={title}
  description={description}
  themeLight="#f4f0e8"
  themeDark="#110f0c"
  image={heroImage}
  ogType="article"
  preloadFonts={['/fonts/fraunces-latin-var.woff2', '/fonts/inter-latin-var.woff2']}
  jsonLd={jsonLd}
>
  <VitrinePage>
    <article class="v-page v-journal" tabindex="-1">
      <a class="v-journal-back" href="/journal">&larr; Journal</a>
      <p class="sp-kicker">{kicker}</p>
      <h1>{title}</h1>
      <p class="v-page-lead">{lead ?? description}</p>
      <Content />
      {
        faqs.length > 0 && (
          <section class="v-journal-faq">
            <h2>Frequently asked questions</h2>
            {faqs.map((f) => (
              <div class="v-journal-faq-item">
                <h3>{f.q}</h3>
                <p>{f.a}</p>
              </div>
            ))}
          </section>
        )
      }
      <p class="sp-meta">Published {dateLabel} &middot; Taranity</p>
      {
        related.length > 0 && (
          <nav class="v-journal-more" aria-label="More from the journal">
            <h2>Keep reading</h2>
            <ul class="v-journal-list">
              {related.map((r) => (
                <li>
                  <a href={`/journal/${r.id}`}>
                    <span class="v-journal-list-kicker">{r.data.kicker}</span>
                    <span class="v-journal-list-title">{r.data.title}</span>
                    <span class="v-journal-list-desc">{r.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </article>
  </VitrinePage>
</SiteLayout>
