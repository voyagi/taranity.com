---
/**
 * The flagship route renders Vitrine (luxury editorial), the first of the
 * design-showcase experiences. Other designs ship at their own routes and the
 * floating switcher links between them (src/config/designs.ts).
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Vitrine from '../components/designs/vitrine/Vitrine.astro';
---

<SiteLayout
  design="vitrine"
  title="Taranity · Digital studio"
  description="Taranity is a digital studio in the Netherlands. We design and build websites, apps, and the systems behind them: crafted, fast, and measured in outcomes."
  themeLight="#f4f0e8"
  themeDark="#110f0c"
  preloadFonts={['/fonts/fraunces-latin-var.woff2', '/fonts/inter-latin-var.woff2']}
  smooth
>
  <Vitrine />
</SiteLayout>
