# taranity.com — environment variables
# Copy to `.env` and fill in. ALL are optional: the site runs in demo mode without them.
# These are PUBLIC_ (build-time, client-exposed) values — none are secrets.

# Web3Forms contact form. Get a key (no account) at https://web3forms.com
# Without it, the form validates + shows success state but does not actually send.
PUBLIC_WEB3FORMS_KEY=

# Plausible analytics domain (cookieless). Leave empty to inject no analytics script.
# Example: taranity.com
PUBLIC_PLAUSIBLE_DOMAIN=

# Booking link (Cal.com / Calendly). Falls back to /contact when empty.
# Example: https://cal.com/taran/intro
PUBLIC_BOOKING_URL=

# GitHub username for the live "Currently" widget (public events, no auth).
# Defaults to "voyagi" if empty.
PUBLIC_GITHUB_USERNAME=voyagi

# Canonical site URL (also set in astro.config.mjs `site`).
PUBLIC_SITE_URL=https://taranity.com
