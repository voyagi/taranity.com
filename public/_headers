# Cloudflare Pages response headers (applied on deploy).
#
# CSP is delivered as a real response header (stronger than a <meta> tag and able
# to set frame-ancestors). script-src is strict — 'self' plus the SHA-256 of each
# first-party inline script (NO 'unsafe-inline'); regenerate the hashes with
# `node scripts/csp-hash.mjs` after changing any inline/component script. style-src
# allows 'unsafe-inline' because GSAP applies dynamic inline styles via JS; style
# injection cannot execute scripts, so XSS protection is unaffected.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' https://challenges.cloudflare.com; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://plausible.io/js/ https://challenges.cloudflare.com 'sha256-NkkFHmJWeTS44HyTSlBAkR81cDoIAbCa3/q9bKkmj9c=' 'sha256-vKLl5epW/72Z8BVeHLxYabj0nTLjVJ4TOmOPL2n2tU0=' 'sha256-nnCW31Wvrpbx4FbdCkxbX/wZbz0+wxkFGoHY+gsVMW8=' 'sha256-GmqvOTeuBWRr1y/IppN6SPIwfiV4EOcN1yeqEW1JnTM=' 'sha256-2D6OUv5tq10pkySomojqGkBZYf1wN8yjut/M8STozR4=' 'sha256-3d9Oi22M0ouWaaM7oUQlvSI6hzcCeq6hBprBCjD1LfU=' 'sha256-VGCqlBPlG73eLK0iPZzJtsDXkUOLVJBbG7YnLEvnlG0=' 'sha256-tmtDdNnuZTfTgAxC8zjrFetXtMfH616IFIUlaBp1KBk='; connect-src 'self' https://api.web3forms.com https://plausible.io https://challenges.cloudflare.com; form-action 'self' https://api.web3forms.com
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-DNS-Prefetch-Control: off

# Long-cache the fingerprinted build assets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static fonts are stable subsetted files (effectively immutable): cache a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Icons, the social card, and the PWA manifest change rarely: cache 30 days.
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon-32.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/og.png
  Cache-Control: public, max-age=2592000
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/icon-maskable-512.png
  Cache-Control: public, max-age=2592000
/site.webmanifest
  Cache-Control: public, max-age=2592000
