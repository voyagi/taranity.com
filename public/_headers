# Cloudflare Pages response headers (applied on deploy).
#
# CSP is delivered as a real response header (stronger than a <meta> tag and able
# to set frame-ancestors). script-src is strict — 'self' plus the SHA-256 of each
# first-party inline script (NO 'unsafe-inline'); regenerate the hashes with
# `node scripts/csp-hash.mjs` after changing any inline/component script. style-src
# allows 'unsafe-inline' because GSAP applies dynamic inline styles via JS; style
# injection cannot execute scripts, so XSS protection is unaffected.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://plausible.io/js/ 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' 'sha256-TNxFDtg6UJ2XPl5t2yUMhL6AEPPEwXSExnX7DfqiLwQ=' 'sha256-h/4eha42KTvREo55Mwxm+Bu7Cep6d7oUNQrYWYNYE3c=' 'sha256-/oCpk51mARyZOUgTt1xWyp7tJxHE+tTHVYIMAA6+D3k='; connect-src 'self' https://api.github.com https://api.web3forms.com https://plausible.io; form-action 'self' https://api.web3forms.com
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-DNS-Prefetch-Control: off

# Long-cache the fingerprinted build assets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
