# Cloudflare Pages response headers (applied on deploy).
#
# CSP is delivered as a real response header (stronger than a <meta> tag and able
# to set frame-ancestors). script-src is strict — 'self' plus the SHA-256 of each
# first-party inline script (NO 'unsafe-inline'); regenerate the hashes with
# `node scripts/csp-hash.mjs` after changing any inline/component script. style-src
# allows 'unsafe-inline' because GSAP applies dynamic inline styles via JS; style
# injection cannot execute scripts, so XSS protection is unaffected.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://plausible.io/js/ 'sha256-NkkFHmJWeTS44HyTSlBAkR81cDoIAbCa3/q9bKkmj9c=' 'sha256-kvv2MMxPgLBmVvzywxyF6zcaAvR+xXG7E4lae3jI0nw=' 'sha256-GDilAfDjHTMwZ/drFnnmquvBS21b1eccrGFOt/ctZko=' 'sha256-QVfN+/3/lmstiP5akREPNxUJav6TFeZ2bk67xinXd8Y=' 'sha256-11m7SNlo670LwLsQC7b+fn1NUPZZl76o1ej/kFLCD7o='; connect-src 'self' https://api.web3forms.com https://plausible.io; form-action 'self' https://api.web3forms.com
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-DNS-Prefetch-Control: off

# Long-cache the fingerprinted build assets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
