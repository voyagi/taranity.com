# Cloudflare Pages response headers (applied on deploy).
#
# CSP is delivered as a real response header (stronger than a <meta> tag and able
# to set frame-ancestors). script-src is strict — 'self' plus the SHA-256 of each
# first-party inline script (NO 'unsafe-inline'); regenerate the hashes with
# `node scripts/csp-hash.mjs` after changing any inline/component script. style-src
# allows 'unsafe-inline' because GSAP applies dynamic inline styles via JS; style
# injection cannot execute scripts, so XSS protection is unaffected.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' https://challenges.cloudflare.com; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://plausible.io/js/ https://challenges.cloudflare.com 'sha256-NkkFHmJWeTS44HyTSlBAkR81cDoIAbCa3/q9bKkmj9c=' 'sha256-vKLl5epW/72Z8BVeHLxYabj0nTLjVJ4TOmOPL2n2tU0=' 'sha256-rxesCQg0lG4g0jDuEj63k3tkIFLaq9/vnb1DcQrciRg=' 'sha256-lEHNV0DqZhx7TM4Zj0kUSJla1Cb4yUevT0PjnBpTEjk=' 'sha256-9MFz9Y+WOH+UE042W4X02mqMt2xSL8ujsww9ZSmwTkU=' 'sha256-Il75f/IuEOpssvF7fOtei7K39w+zp7ntlapqBgFomqo=' 'sha256-rlltbx+hRnIgCmuhN+xCdcFrIB6qTvKsaTeywvUA8vc=' 'sha256-NiVebH17DjIAb4XMSCPHxXE+MvkzFbKpWFZCq3w+8NA='; connect-src 'self' https://plausible.io https://challenges.cloudflare.com; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-DNS-Prefetch-Control: off
  # HTML must revalidate so the edge never serves a stale page that points at
  # fingerprinted assets a newer deploy has replaced (the more-specific rules
  # below keep the hashed assets themselves immutable).
  Cache-Control: public, max-age=0, must-revalidate

# Long-cache the fingerprinted build assets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static fonts are stable subsetted files (effectively immutable): cache a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Icons, the social card, and the PWA manifest change rarely: cache 30 days.
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon-32.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/og.png
  Cache-Control: public, max-age=2592000
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/icon-maskable-512.png
  Cache-Control: public, max-age=2592000
/site.webmanifest
  Cache-Control: public, max-age=2592000
